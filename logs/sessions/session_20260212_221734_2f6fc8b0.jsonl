{"correlation_id": "d67d080d-6164-4073-b206-764ad1889ce9", "start_time": 1770934774.9094849, "audio_duration_sec": 1.108, "asr_duration": 0.41527795791625977, "asr_confidence": 0.6047563148276319, "asr_text": "Neun.", "asr_word_count": 1, "llm_duration": 1.8999114036560059, "llm_text": "Ninth.", "llm_word_count": 1, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.3113696575164795, "tts_audio_size_bytes": 171596, "e2e_duration": 9.570855617523193, "rtf": 8.638, "timestamp": "2026-02-12T22:19:44.480354"}
