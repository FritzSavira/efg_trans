{"correlation_id": "2f30effb-263c-4ae3-8ea8-cdc7b4d1f4cc", "start_time": 1770981305.607208, "audio_duration_sec": 3.124, "asr_duration": 0.7918198108673096, "asr_confidence": 0.8671198061881411, "asr_text": "Und gemeinsam die Zusammenhänge zwischen Jüngerschaft.", "asr_word_count": 6, "llm_duration": 2.729165554046631, "llm_text": "And together the connections of discipleship.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.5793707370758057, "tts_audio_size_bytes": 162380, "e2e_duration": 5.101046800613403, "rtf": 1.633, "timestamp": "2026-02-13T11:15:10.708265"}
{"correlation_id": "1db3f3fa-48c4-4651-ad1c-4541a3314030", "start_time": 1770981310.060302, "audio_duration_sec": 0.948, "asr_duration": 0.6656372547149658, "asr_confidence": 0.6532592204584253, "asr_text": "anschauen.", "asr_word_count": 1, "rejected": true, "rejection_reason": "low_confidence"}
