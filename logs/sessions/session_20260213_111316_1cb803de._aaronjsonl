{"correlation_id": "a58e5059-b6ea-423c-ba9d-0e68ac83466c", "start_time": 1770981292.264378, "audio_duration_sec": 5.172, "asr_duration": 0.8416447639465332, "asr_confidence": 0.9144621900387657, "asr_text": "Das Beherrschen des eigenen Willens, der eigenen Gefühle und Neigungen.", "asr_word_count": 10, "llm_duration": 3.7379400730133057, "llm_text": "The mastery of one's own will, emotions, and inclinations.", "llm_word_count": 9, "src_lang": "de", "tgt_lang": "en", "tts_duration": 2.5540173053741455, "tts_audio_size_bytes": 264780, "e2e_duration": 7.134262561798096, "rtf": 1.379, "timestamp": "2026-02-13T11:14:59.398655"}
{"correlation_id": "b43afe43-42b1-4635-b1ba-9bb1f843a747", "start_time": 1770981295.1354544, "audio_duration_sec": 2.164, "asr_duration": 0.5699849128723145, "asr_confidence": 0.8445550934488766, "asr_text": "um etwas zu erreichen.", "asr_word_count": 4, "llm_duration": 2.5995419025421143, "llm_text": "that something might be achieved.", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.8254799842834473, "tts_audio_size_bytes": 99916, "e2e_duration": 5.1345274448394775, "rtf": 2.373, "timestamp": "2026-02-13T11:15:00.269991"}
{"correlation_id": "51280031-7e76-409f-81bd-b0ee61197beb", "start_time": 1770981301.9493883, "audio_duration_sec": 3.54, "asr_duration": 0.5644850730895996, "asr_confidence": 0.877038801524085, "asr_text": "Wir wollen uns heute mal ein bisschen diesem Spannungsfeld stellen.", "asr_word_count": 10, "llm_duration": 2.581800699234009, "llm_text": "Let us today confront this tension a little.", "llm_word_count": 8, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.725339412689209, "tts_audio_size_bytes": 126540, "e2e_duration": 4.87234354019165, "rtf": 1.376, "timestamp": "2026-02-13T11:15:06.821750"}
