{"correlation_id": "321ca211-ff29-43d9-ab21-753b44f20adb", "start_time": 1770981251.7689362, "audio_duration_sec": 0.404, "asr_duration": 0.5932135581970215, "asr_confidence": 0.7111866951488627, "asr_text": "Vielen Dank.", "asr_word_count": 2, "llm_duration": 1.3450393676757812, "llm_text": "Thanks.", "llm_word_count": 1, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.5719072818756104, "tts_audio_size_bytes": 75340, "e2e_duration": 4.197188377380371, "rtf": 10.389, "timestamp": "2026-02-13T11:14:15.966136"}
{"correlation_id": "02b2eddb-3880-46d1-97d5-e88fe7dbc8fd", "start_time": 1770981257.7968068, "audio_duration_sec": 1.748, "asr_duration": 0.6448235511779785, "asr_confidence": 0.9266569212020481, "asr_text": "Haben wir eine Folie eigentlich auch?", "asr_word_count": 6, "llm_duration": 2.526155471801758, "llm_text": "Do we have a veil, actually?", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.1309902667999268, "tts_audio_size_bytes": 147020, "e2e_duration": 4.30317234992981, "rtf": 2.462, "timestamp": "2026-02-13T11:14:22.099991"}
{"correlation_id": "7bed36a7-46a2-485b-93e6-d7f8069c0a20", "start_time": 1770981260.3012226, "audio_duration_sec": 1.428, "asr_duration": 0.5971963405609131, "asr_confidence": 0.8080691528693629, "asr_text": "Super, Dankeschön.", "asr_word_count": 2, "llm_duration": 2.437434434890747, "llm_text": "Very, Thanks be to God.", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.4952061176300049, "tts_audio_size_bytes": 204876, "e2e_duration": 4.6006128787994385, "rtf": 3.222, "timestamp": "2026-02-13T11:14:24.901846"}
{"correlation_id": "51c458a0-4a55-4137-9001-bf101938ea3e", "start_time": 1770981267.3985426, "audio_duration_sec": 0.82, "asr_duration": 0.3919796943664551, "asr_confidence": 0.6795032793825322, "asr_text": "Ähm.", "asr_word_count": 1, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "1ac40c30-f1ee-4776-9dab-ec6dcb22f7b6", "start_time": 1770981266.3677332, "audio_duration_sec": 2.1, "asr_duration": 0.5130598545074463, "asr_confidence": 0.8755634782214573, "asr_text": "Dann müsstet ihr einmal. Perfekt.", "asr_word_count": 5, "llm_duration": 2.114084482192993, "llm_text": "Then ye shall be perfect.", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.61376953125, "tts_audio_size_bytes": 93260, "e2e_duration": 3.2415950298309326, "rtf": 1.544, "timestamp": "2026-02-13T11:14:29.609338"}
{"correlation_id": "5362a2d9-e461-4239-83bb-a6d9db28bd48", "start_time": 1770981270.0314672, "audio_duration_sec": 2.164, "asr_duration": 0.46237635612487793, "asr_confidence": 0.8493108042797994, "asr_text": "Ein Disciple oder ein Jünger", "asr_word_count": 5, "llm_duration": 1.8821501731872559, "llm_text": "A disciple or a pupil", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.140998125076294, "tts_audio_size_bytes": 144460, "e2e_duration": 3.4862582683563232, "rtf": 1.611, "timestamp": "2026-02-13T11:14:33.517734"}
{"correlation_id": "1ebcd0ad-bd70-449d-83c1-d73072ef20fe", "start_time": 1770981281.8010323, "audio_duration_sec": 0.468, "asr_duration": 0.37833547592163086, "asr_confidence": 0.3819368493039489, "asr_text": "Ja.", "asr_word_count": 1, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "ffb9ca7a-6b3f-4169-83cc-8e7d172672ca", "start_time": 1770981277.6016178, "audio_duration_sec": 6.484, "asr_duration": 0.9940769672393799, "asr_confidence": 0.9774839204709955, "asr_text": "wird als derjenige beschrieben, der vom Meister unterrichtet oder ausgebildet wurde.", "asr_word_count": 11, "llm_duration": 3.6764206886291504, "llm_text": "is described as one who was taught or instructed by the Master.", "llm_word_count": 12, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.5335383415222168, "tts_audio_size_bytes": 209484, "e2e_duration": 6.204807996749878, "rtf": 0.957, "timestamp": "2026-02-13T11:14:43.806441"}
{"correlation_id": "96b47848-f957-496c-8079-3d0566a6d150", "start_time": 1770981280.2251606, "audio_duration_sec": 2.196, "asr_duration": 0.46299242973327637, "asr_confidence": 0.8923183706727684, "asr_text": "Das sagt zumindest C.S. Lewis.", "asr_word_count": 5, "llm_duration": 3.0962624549865723, "llm_text": "At least C.S. Lewis says this.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.8403875827789307, "tts_audio_size_bytes": 113228, "e2e_duration": 5.984735488891602, "rtf": 2.725, "timestamp": "2026-02-13T11:14:46.209904"}
{"correlation_id": "e80e506a-6e7b-4b78-bcde-4dd3a04b98f2", "start_time": 1770981284.1523056, "audio_duration_sec": 2.42, "asr_duration": 0.47768306732177734, "asr_confidence": 0.8235152799904353, "asr_text": "Und Disziplin oder Disziplin.", "asr_word_count": 4, "llm_duration": 2.186217784881592, "llm_text": "And discipline or discipline.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.3608920574188232, "tts_audio_size_bytes": 169036, "e2e_duration": 4.764651775360107, "rtf": 1.969, "timestamp": "2026-02-13T11:14:48.916971"}
{"correlation_id": "fe909a40-39ad-4ae0-8b3c-75949ea10cb4", "start_time": 1770981286.2516153, "audio_duration_sec": 1.748, "asr_duration": 0.4527401924133301, "asr_confidence": 0.822818589675736, "asr_text": "Lässt sich beschreiben durch", "asr_word_count": 4, "llm_duration": 1.9449868202209473, "llm_text": "Can be described by", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.6570804119110107, "tts_audio_size_bytes": 91212, "e2e_duration": 3.906872034072876, "rtf": 2.235, "timestamp": "2026-02-13T11:14:50.158499"}
