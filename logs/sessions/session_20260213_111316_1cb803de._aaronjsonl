{"correlation_id": "5cccc0e5-116f-4035-8c7e-87c6f3aa9353", "start_time": 1770981215.1167822, "audio_duration_sec": 1.492, "asr_duration": 0.6643261909484863, "asr_confidence": 0.8832632915096024, "asr_text": "Wie macht ihr das immer?", "asr_word_count": 5, "llm_duration": 2.1987831592559814, "llm_text": "How do you always do that?", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.6797218322753906, "tts_audio_size_bytes": 73292, "e2e_duration": 3.543562412261963, "rtf": 2.375, "timestamp": "2026-02-13T11:13:38.660354"}
{"correlation_id": "b4933175-346e-4bb0-b77e-43064000e680", "start_time": 1770981225.9016793, "audio_duration_sec": 0.916, "asr_duration": 0.39652109146118164, "asr_confidence": 0.6057414201887887, "asr_text": "Ähm.", "asr_word_count": 1, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "5b6611e9-6e1f-451a-ba17-fcf0dda432a5", "start_time": 1770981224.9036973, "audio_duration_sec": 7.732, "asr_duration": 1.1124448776245117, "asr_confidence": 0.895256925400661, "asr_text": "wieder ein Phänomen, hier vorne zu stehen und erstmal zu sehen, vor wie vielen Leuten man steht.  Darum soll es aber heute nicht gehen und das ist schön.", "asr_word_count": 28, "llm_duration": 7.6121745109558105, "llm_text": "another phenomenon, to stand up front and first to see how many people are there. But that is not what this is about today, and that is nice.", "llm_word_count": 28, "src_lang": "de", "tgt_lang": "en", "tts_duration": 4.975384473800659, "tts_audio_size_bytes": 552044, "e2e_duration": 13.700665473937988, "rtf": 1.772, "timestamp": "2026-02-13T11:13:58.604382"}
{"correlation_id": "e2c392b8-3301-4850-81eb-1f7cf2b3a734", "start_time": 1770981228.1612515, "audio_duration_sec": 1.012, "asr_duration": 0.43845295906066895, "asr_confidence": 0.8291303195678011, "asr_text": "Im Englischen.", "asr_word_count": 2, "llm_duration": 1.8769605159759521, "llm_text": "In English.", "llm_word_count": 2, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.4884607791900635, "tts_audio_size_bytes": 62028, "e2e_duration": 10.946075439453125, "rtf": 10.816, "timestamp": "2026-02-13T11:13:59.107339"}
{"correlation_id": "a9f2445f-63d5-4ae3-93fc-a4295b519cfe", "start_time": 1770981229.666556, "audio_duration_sec": 1.428, "asr_duration": 0.46857428550720215, "asr_confidence": 0.8394570182674305, "asr_text": "gibt es zwei Wörter.", "asr_word_count": 4, "llm_duration": 2.346651554107666, "llm_text": "there are two words.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.0452229976654053, "tts_audio_size_bytes": 133708, "e2e_duration": 10.487207412719727, "rtf": 7.344, "timestamp": "2026-02-13T11:14:00.153781"}
{"correlation_id": "7d00b270-20a9-42e1-9d6c-c4b08a500d72", "start_time": 1770981233.1800969, "audio_duration_sec": 1.684, "asr_duration": 1.247401475906372, "asr_confidence": 0.9166365144725186, "asr_text": "Wer ist der englischen Sprache mächtig?", "asr_word_count": 6, "llm_duration": 3.0813634395599365, "llm_text": "Who is master of the English language?", "llm_word_count": 7, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.8831319808959961, "tts_audio_size_bytes": 109132, "e2e_duration": 8.63804292678833, "rtf": 5.129, "timestamp": "2026-02-13T11:14:01.818149"}
{"correlation_id": "43647916-a844-411f-8571-0e499d86f9ac", "start_time": 1770981242.4627209, "audio_duration_sec": 1.396, "asr_duration": 0.4183676242828369, "asr_confidence": 0.6286935452434032, "asr_text": "Und Disziplin.", "asr_word_count": 2, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "b9bc22ec-1f96-4a3c-84df-1c33684d3070", "start_time": 1770981240.2061703, "audio_duration_sec": 5.3, "asr_duration": 0.6940250396728516, "asr_confidence": 0.906227915955948, "asr_text": "Gut, dann könnt ihr es euch wahrscheinlich schon selber übersetzen.  Diese zwei Wörter lauten Disciple.", "asr_word_count": 15, "llm_duration": 4.507670164108276, "llm_text": "Good, then you can probably translate it yourselves. These two words are Disciple.", "llm_word_count": 13, "src_lang": "de", "tgt_lang": "en", "tts_duration": 4.405160188674927, "tts_audio_size_bytes": 331372, "e2e_duration": 9.642011880874634, "rtf": 1.819, "timestamp": "2026-02-13T11:14:09.848196"}
{"correlation_id": "696ef1b4-1f7b-4454-94d2-05109e886ae0", "start_time": 1770981245.4721277, "audio_duration_sec": 1.3, "asr_duration": 0.8486006259918213, "asr_confidence": 0.7868824961082198, "asr_text": "Also zu Deutsch.", "asr_word_count": 3, "llm_duration": 2.0801713466644287, "llm_text": "Also in German.", "llm_word_count": 3, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.8755571842193604, "tts_audio_size_bytes": 104524, "e2e_duration": 5.2582502365112305, "rtf": 4.045, "timestamp": "2026-02-13T11:14:10.730388"}
