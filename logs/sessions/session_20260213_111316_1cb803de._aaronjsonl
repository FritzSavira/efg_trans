{"correlation_id": "d1d73409-0f5b-4ff8-9ac7-da030c81b8e8", "start_time": 1770981248.507179, "audio_duration_sec": 1.396, "asr_duration": 0.7094697952270508, "asr_confidence": 0.7637374208907363, "asr_text": "Oder Nachfolger.", "asr_word_count": 2, "llm_duration": 1.9227235317230225, "llm_text": "Or successors.", "llm_word_count": 2, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.729320764541626, "tts_audio_size_bytes": 91212, "e2e_duration": 5.598890066146851, "rtf": 4.011, "timestamp": "2026-02-13T11:14:14.106079"}
