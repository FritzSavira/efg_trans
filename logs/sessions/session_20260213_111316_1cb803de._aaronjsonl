{"correlation_id": "9b68a4e9-0359-4759-8309-45d2cb91b166", "start_time": 1770981322.6466677, "audio_duration_sec": 0.5, "asr_duration": 0.4463307857513428, "asr_confidence": 0.5700054464184684, "asr_text": "Untertitelung. BR 2018", "asr_word_count": 3, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "a976b585-03e0-4118-9862-65cfd84d3644", "start_time": 1770981316.6214416, "audio_duration_sec": 5.268, "asr_duration": 0.9549241065979004, "asr_confidence": 0.9044432696316291, "asr_text": "Schlagt dafür gerne eure eigene Bibel auf oder lest vorne mit aus dem ersten Korintherbrief.", "asr_word_count": 15, "llm_duration": 5.4441468715667725, "llm_text": "Open your Bible and read from the first letter to the Corinthians, or your own Bible and turn to it.", "llm_word_count": 20, "src_lang": "de", "tgt_lang": "en", "tts_duration": 4.162533283233643, "tts_audio_size_bytes": 465484, "e2e_duration": 10.562294244766235, "rtf": 2.005, "timestamp": "2026-02-13T11:15:27.183751"}
{"correlation_id": "bcbfd22e-aab2-431f-bde4-58e73b3cb509", "start_time": 1770981320.8086674, "audio_duration_sec": 2.004, "asr_duration": 0.6798231601715088, "asr_confidence": 0.8210727605971385, "asr_text": "Ab dem Vers 24.", "asr_word_count": 4, "llm_duration": 2.7165093421936035, "llm_text": "From verse 24.", "llm_word_count": 3, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.5788769721984863, "tts_audio_size_bytes": 77900, "e2e_duration": 6.9665207862854, "rtf": 3.476, "timestamp": "2026-02-13T11:15:27.775201"}
{"correlation_id": "f50954b7-7435-4b19-9077-39571cb8c260", "start_time": 1770981323.9652996, "audio_duration_sec": 1.076, "asr_duration": 0.7781720161437988, "asr_confidence": 0.8754155115148434, "asr_text": "Paulus schreibt.", "asr_word_count": 2, "llm_duration": 1.922133445739746, "llm_text": "Paul writes.", "llm_word_count": 2, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.7754340171813965, "tts_audio_size_bytes": 113228, "e2e_duration": 4.586825370788574, "rtf": 4.263, "timestamp": "2026-02-13T11:15:28.552134"}
{"correlation_id": "1f58decc-a6e7-45dd-a87d-286df7206486", "start_time": 1770981328.9530535, "audio_duration_sec": 3.508, "asr_duration": 0.5557160377502441, "asr_confidence": 0.9370501239723821, "asr_text": "Wisst ihr nicht, dass die, welche in der Rennbahn laufen,", "asr_word_count": 10, "llm_duration": 4.173396110534668, "llm_text": "Do you not know that those who run in the race must run to win?", "llm_word_count": 15, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.5513646602630615, "tts_audio_size_bytes": 202828, "e2e_duration": 6.28119158744812, "rtf": 1.791, "timestamp": "2026-02-13T11:15:35.234259"}
{"correlation_id": "16d3aaf6-2e48-4a6c-8225-b0a54a901eb3", "start_time": 1770981330.5207515, "audio_duration_sec": 1.492, "asr_duration": 0.4155876636505127, "asr_confidence": 0.8009763679155142, "asr_text": "Zwar alle laufen,", "asr_word_count": 3, "llm_duration": 1.7803938388824463, "llm_text": "Yet all run", "llm_word_count": 3, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.850701093673706, "tts_audio_size_bytes": 109132, "e2e_duration": 5.793564081192017, "rtf": 3.883, "timestamp": "2026-02-13T11:15:36.314338"}
{"correlation_id": "0332d943-b74d-4ff2-b5d6-3c579ffecaa4", "start_time": 1770981332.6235628, "audio_duration_sec": 2.1, "asr_duration": 0.4595358371734619, "asr_confidence": 0.8447800534577445, "asr_text": "aber einer den Preis empfängt?", "asr_word_count": 5, "llm_duration": 2.355098009109497, "llm_text": "but who receives the reward?", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.845923900604248, "tts_audio_size_bytes": 102476, "e2e_duration": 6.041402816772461, "rtf": 2.877, "timestamp": "2026-02-13T11:15:38.664974"}
{"correlation_id": "598fbbd4-e983-4bda-a46d-f6df411880a2", "start_time": 1770981336.558782, "audio_duration_sec": 2.42, "asr_duration": 0.48879408836364746, "asr_confidence": 0.9027317829141455, "asr_text": "Lauft so, dass ihr ihn erlangt.", "asr_word_count": 6, "llm_duration": 2.65493106842041, "llm_text": "Run so that you may obtain it.", "llm_word_count": 7, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.7540946006774902, "tts_audio_size_bytes": 93260, "e2e_duration": 4.669620513916016, "rtf": 1.93, "timestamp": "2026-02-13T11:15:41.228416"}
{"correlation_id": "1e73329d-c559-434a-a9dd-9ed4af7cc1b8", "start_time": 1770981343.0882034, "audio_duration_sec": 0.436, "asr_duration": 0.6204006671905518, "asr_confidence": 0.5064455104331599, "asr_text": "... Musik ...", "asr_word_count": 3, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "0054620f-e822-46e9-8d29-e0ae001286db", "start_time": 1770981339.957246, "audio_duration_sec": 1.844, "asr_duration": 0.4830443859100342, "asr_confidence": 0.8670428321600439, "asr_text": "Jeder aber, der kämpft,", "asr_word_count": 4, "llm_duration": 2.2838644981384277, "llm_text": "But every one who fights,", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.1725120544433594, "tts_audio_size_bytes": 86604, "e2e_duration": 3.97377610206604, "rtf": 2.155, "timestamp": "2026-02-13T11:15:43.931034"}
{"correlation_id": "5e4ddeef-87ca-4f0d-a419-e142ab628c24", "start_time": 1770981341.774475, "audio_duration_sec": 1.812, "asr_duration": 0.45708179473876953, "asr_confidence": 0.8011719438533252, "asr_text": "ist enthaltsam in allem.", "asr_word_count": 4, "llm_duration": 2.5102734565734863, "llm_text": "is含蓄在一切中.", "llm_word_count": 1, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.6394495964050293, "tts_audio_size_bytes": 236108, "e2e_duration": 5.1341142654418945, "rtf": 2.833, "timestamp": "2026-02-13T11:15:46.908601"}
{"correlation_id": "f7625b13-5ee8-4a7a-94c0-42c5e9767b5d", "start_time": 1770981349.3798938, "audio_duration_sec": 1.236, "asr_duration": 0.39043164253234863, "asr_confidence": 0.637918790917907, "asr_text": "Wir aber.", "asr_word_count": 2, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "fa0a7967-d11f-4a84-9cdb-bcdd494a6fe1", "start_time": 1770981347.2964075, "audio_duration_sec": 4.148, "asr_duration": 0.60801100730896, "asr_confidence": 0.9315485903418363, "asr_text": "Jene freilich, damit sie einen vergänglichen Siegeskranz empfangen.", "asr_word_count": 8, "llm_duration": 3.1350576877593994, "llm_text": "That they may receive a perishable crown of victory.", "llm_word_count": 9, "src_lang": "de", "tgt_lang": "en", "tts_duration": 2.0443015098571777, "tts_audio_size_bytes": 195660, "e2e_duration": 5.788091421127319, "rtf": 1.395, "timestamp": "2026-02-13T11:15:53.084512"}
{"correlation_id": "40424e52-2477-45e1-a093-98a05614241b", "start_time": 1770981351.2099361, "audio_duration_sec": 1.684, "asr_duration": 0.79372239112854, "asr_confidence": 0.8353680966403548, "asr_text": "einen unvergänglichen.", "asr_word_count": 2, "llm_duration": 2.0899693965911865, "llm_text": "an incorruptible.", "llm_word_count": 2, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.45041608810424805, "tts_audio_size_bytes": 71244, "e2e_duration": 3.3348677158355713, "rtf": 1.98, "timestamp": "2026-02-13T11:15:54.544812"}
{"correlation_id": "8de3fa7c-69c4-4c39-a105-63ba653a0a3a", "start_time": 1770981356.1772568, "audio_duration_sec": 2.804, "asr_duration": 0.5317754745483398, "asr_confidence": 0.9269963351681921, "asr_text": "Ich laufe nun so nicht wie ins Ungewisse.", "asr_word_count": 8, "llm_duration": 2.9632582664489746, "llm_text": "I no longer run as one who runs uncertainly.", "llm_word_count": 9, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.9898197650909424, "tts_audio_size_bytes": 142412, "e2e_duration": 5.485476016998291, "rtf": 1.956, "timestamp": "2026-02-13T11:16:01.662744"}
{"correlation_id": "8423a4d3-3375-49d1-b571-002f1c4fde1b", "start_time": 1770981360.3582475, "audio_duration_sec": 3.444, "asr_duration": 1.2576992511749268, "asr_confidence": 0.9792825578525428, "asr_text": "Ich kämpfe so nicht wie einer, der in die Luft schlägt.", "asr_word_count": 11, "llm_duration": 3.291729211807251, "llm_text": "I do not fight as one who beateth the air.", "llm_word_count": 10, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.6658706665039062, "tts_audio_size_bytes": 131148, "e2e_duration": 6.216179132461548, "rtf": 1.805, "timestamp": "2026-02-13T11:16:06.574440"}
{"correlation_id": "28623e78-20a3-4665-a6b7-f85ce1632f43", "start_time": 1770981363.7703843, "audio_duration_sec": 2.74, "asr_duration": 0.7182645797729492, "asr_confidence": 0.9061434115242846, "asr_text": "sondern ich zerschlage meinen Leib.", "asr_word_count": 5, "llm_duration": 2.619251012802124, "llm_text": "but I will break my body.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.6144192218780518, "tts_audio_size_bytes": 79948, "e2e_duration": 4.372186660766602, "rtf": 1.596, "timestamp": "2026-02-13T11:16:08.142591"}
{"correlation_id": "e2986b5c-de6e-413a-b7e3-57197f062a13", "start_time": 1770981365.3520555, "audio_duration_sec": 1.332, "asr_duration": 0.8069944381713867, "asr_confidence": 0.9038169100598277, "asr_text": "Und knechte ihn.", "asr_word_count": 3, "llm_duration": 1.7283174991607666, "llm_text": "And serve him.", "llm_word_count": 3, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.0576391220092773, "tts_audio_size_bytes": 59980, "e2e_duration": 4.9624128341674805, "rtf": 3.726, "timestamp": "2026-02-13T11:16:10.314478"}
{"correlation_id": "af662437-a6d2-49bb-aa22-608a129d004d", "start_time": 1770981369.2822225, "audio_duration_sec": 3.284, "asr_duration": 0.7519385814666748, "asr_confidence": 0.9375800609876456, "asr_text": "damit ich nicht, nachdem ich anderen gepredigt habe,", "asr_word_count": 8, "llm_duration": 2.5563197135925293, "llm_text": "lest I should after having preached to others", "llm_word_count": 8, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.8950004577636719, "tts_audio_size_bytes": 113228, "e2e_duration": 4.204138994216919, "rtf": 1.28, "timestamp": "2026-02-13T11:16:13.486371"}
{"correlation_id": "14b29555-ac95-470c-81c4-e91b3bfdb402", "start_time": 1770981371.390073, "audio_duration_sec": 2.004, "asr_duration": 0.44315385818481445, "asr_confidence": 0.9366649050910983, "asr_text": "selbst verwerflich werde.", "asr_word_count": 3, "llm_duration": 2.4643912315368652, "llm_text": "myself even I abhor.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.7697865962982178, "tts_audio_size_bytes": 111180, "e2e_duration": 4.4358069896698, "rtf": 2.213, "timestamp": "2026-02-13T11:16:15.825889"}
{"correlation_id": "50419149-3d38-467d-81a5-11064ba07bba", "start_time": 1770981377.9237757, "audio_duration_sec": 1.524, "asr_duration": 0.6077561378479004, "asr_confidence": 0.8520862931001401, "asr_text": "Lassen wir erst mal sacken.", "asr_word_count": 5, "llm_duration": 1.8082234859466553, "llm_text": "Let us first sink.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.5321056842803955, "tts_audio_size_bytes": 66636, "e2e_duration": 2.9487967491149902, "rtf": 1.935, "timestamp": "2026-02-13T11:16:20.872581"}
{"correlation_id": "16faf3c9-21fb-4c66-9b4f-e9e4401abd3b", "start_time": 1770981386.5931234, "audio_duration_sec": 5.876, "asr_duration": 1.0692265033721924, "asr_confidence": 0.9075860346645768, "asr_text": "Der Josef hat uns vorhin schon ein bisschen in den Hintergrund mit reingenommen.  Ich möchte es mal zeitlich einordnen.", "asr_word_count": 19, "llm_duration": 5.150325298309326, "llm_text": "Joseph has already taken us a little behind the scenes earlier. I would like to place it in time now.", "llm_word_count": 20, "src_lang": "de", "tgt_lang": "en", "tts_duration": 4.690362930297852, "tts_audio_size_bytes": 387180, "e2e_duration": 10.910684585571289, "rtf": 1.857, "timestamp": "2026-02-13T11:16:37.503820"}
{"correlation_id": "1f125c00-ef81-4609-bfe4-053140124f51", "start_time": 1770981393.9446168, "audio_duration_sec": 6.452, "asr_duration": 2.0902514457702637, "asr_confidence": 0.9518309780847392, "asr_text": "Die frühe Gemeinde in Korinth, die konnte mit diesem Bild, was Paulus ihnen hier schreibt, wahrscheinlich auf Anhieb sehr viel anfangen.", "asr_word_count": 21, "llm_duration": 5.46385383605957, "llm_text": "The early church in Corinth, no doubt, could grasp this image that Paul writes to them very readily.", "llm_word_count": 18, "src_lang": "de", "tgt_lang": "en", "tts_duration": 3.468074321746826, "tts_audio_size_bytes": 291916, "e2e_duration": 11.023282766342163, "rtf": 1.709, "timestamp": "2026-02-13T11:16:44.967914"}
{"correlation_id": "6dc72bd3-8520-4bfb-9b16-4935831d0b49", "start_time": 1770981402.0643775, "audio_duration_sec": 6.964, "asr_duration": 1.3400804996490479, "asr_confidence": 0.9618080036508592, "asr_text": "Die waren es nämlich gewohnt, dass alle zwei Jahre die sogenannten isthmischen Spiele stattgefunden haben in Korinth.", "asr_word_count": 17, "llm_duration": 6.320827960968018, "llm_text": "They were accustomed, however, for the games called the Isthmian Games to be held in Corinth every two years.", "llm_word_count": 19, "src_lang": "de", "tgt_lang": "en", "tts_duration": 3.370488166809082, "tts_audio_size_bytes": 354380, "e2e_duration": 11.032082319259644, "rtf": 1.584, "timestamp": "2026-02-13T11:16:53.096475"}
{"correlation_id": "73d87760-d6c6-408c-bc98-62e6f175c015", "start_time": 1770981407.5786715, "audio_duration_sec": 4.596, "asr_duration": 0.8072779178619385, "asr_confidence": 0.9305563389766243, "asr_text": "Das war einer der vier größten griechischen Wettkämpfe.", "asr_word_count": 8, "llm_duration": 3.687126398086548, "llm_text": "This was one of the four great Greek contests.", "llm_word_count": 9, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.4078395366668701, "tts_audio_size_bytes": 186956, "e2e_duration": 7.242603778839111, "rtf": 1.576, "timestamp": "2026-02-13T11:16:54.821289"}
{"correlation_id": "7533539c-e71e-4097-939a-9ad46e308973", "start_time": 1770981410.7265234, "audio_duration_sec": 2.772, "asr_duration": 0.7822005748748779, "asr_confidence": 0.8385780761872295, "asr_text": "und hat Athleten aus dem ganzen Land", "asr_word_count": 7, "llm_duration": 2.5645127296447754, "llm_text": "and hath athletes from throughout the land", "llm_word_count": 7, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.9858047962188721, "tts_audio_size_bytes": 153676, "e2e_duration": 6.237568616867065, "rtf": 2.25, "timestamp": "2026-02-13T11:16:56.964103"}
{"correlation_id": "93227783-3fc9-4b08-a827-57e244809f1c", "start_time": 1770981419.875752, "audio_duration_sec": 8.468, "asr_duration": 1.0514805316925049, "asr_confidence": 0.9380268041769809, "asr_text": "Und aufgrund der Lage von Korinth, es war ja eine Hafenstadt, auch aus anderen Ländern angezogen.  Aber nicht nur Athleten, sondern auch Zuschauer.", "asr_word_count": 23, "llm_duration": 7.09478497505188, "llm_text": "And because of the location of Corinth, a seaport city, it attracted people from other lands. But not only athletes, but also spectators.", "llm_word_count": 23, "src_lang": "de", "tgt_lang": "en", "tts_duration": 5.179421663284302, "tts_audio_size_bytes": 587884, "e2e_duration": 13.326433658599854, "rtf": 1.574, "timestamp": "2026-02-13T11:17:13.202200"}
{"correlation_id": "ddec4a4a-8989-44a3-9a4d-9370d9c6ffde", "start_time": 1770981425.1145275, "audio_duration_sec": 2.228, "asr_duration": 0.8196091651916504, "asr_confidence": 0.9117423529613361, "asr_text": "Ein Hauptbestandteil dieser Festspiele", "asr_word_count": 4, "llm_duration": 2.7039504051208496, "llm_text": "A main component of these festivals", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.7347240447998047, "tts_audio_size_bytes": 131148, "e2e_duration": 9.839677810668945, "rtf": 4.416, "timestamp": "2026-02-13T11:17:14.954213"}
{"correlation_id": "63da6f6c-53b5-4675-8e2d-99cd5834775a", "start_time": 1770981427.215288, "audio_duration_sec": 1.876, "asr_duration": 0.47882819175720215, "asr_confidence": 0.86816264977896, "asr_text": "War der Wettkampf in Lauf?", "asr_word_count": 5, "llm_duration": 2.9588851928710938, "llm_text": "Was was the race a contest?", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.7310271263122559, "tts_audio_size_bytes": 93260, "e2e_duration": 8.474725484848022, "rtf": 4.517, "timestamp": "2026-02-13T11:17:15.690025"}
{"correlation_id": "0e9867c5-f6c7-419b-a6bb-a197e681542b", "start_time": 1770981430.3586476, "audio_duration_sec": 1.94, "asr_duration": 0.81252121925354, "asr_confidence": 0.7584109078484891, "asr_text": "In Ring- und Faustkampf?", "asr_word_count": 4, "llm_duration": 2.7615573406219482, "llm_text": "In wrestling and fistfighting?", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.6840243339538574, "tts_audio_size_bytes": 88652, "e2e_duration": 6.7735230922698975, "rtf": 3.492, "timestamp": "2026-02-13T11:17:17.132180"}
{"correlation_id": "ca46326b-6080-43c1-ab89-2f505c6ed1d4", "start_time": 1770981434.0336583, "audio_duration_sec": 2.388, "asr_duration": 0.9251961708068848, "asr_confidence": 0.8247608404517539, "asr_text": "und in Wagen und Pferde rennen.", "asr_word_count": 6, "llm_duration": 2.6624279022216797, "llm_text": "and in chariots and horses run.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.1683340072631836, "tts_audio_size_bytes": 157772, "e2e_duration": 6.245599746704102, "rtf": 2.615, "timestamp": "2026-02-13T11:17:20.279269"}
{"correlation_id": "6f153a2f-becf-44e4-94b4-a20a441f7624", "start_time": 1770981441.8650572, "audio_duration_sec": 4.98, "asr_duration": 0.6455395221710205, "asr_confidence": 0.9043809911561825, "asr_text": "Wie das der Josef auch schon gemacht hat, können wir das wahrscheinlich heute am besten vergleichen mit", "asr_word_count": 17, "llm_duration": 3.5228631496429443, "llm_text": "As Joseph also did, we can probably best compare this today with", "llm_word_count": 12, "src_lang": "de", "tgt_lang": "en", "tts_duration": 2.2821972370147705, "tts_audio_size_bytes": 262732, "e2e_duration": 6.451348304748535, "rtf": 1.295, "timestamp": "2026-02-13T11:17:28.316417"}
{"correlation_id": "1350b697-3bfe-47ab-b1b1-9b8d499d642e", "start_time": 1770981443.9518669, "audio_duration_sec": 1.46, "asr_duration": 0.4411957263946533, "asr_confidence": 0.8023028714370828, "asr_text": "den Olympischen Spielen.", "asr_word_count": 3, "llm_duration": 2.084345579147339, "llm_text": "the Olympic Games.", "llm_word_count": 3, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.5359165668487549, "tts_audio_size_bytes": 84556, "e2e_duration": 4.906134605407715, "rtf": 3.36, "timestamp": "2026-02-13T11:17:28.858012"}
{"correlation_id": "36026965-c8ce-4fab-89e3-0e106b27929d", "start_time": 1770981450.7963994, "audio_duration_sec": 4.596, "asr_duration": 0.7892212867736816, "asr_confidence": 0.9613105448673875, "asr_text": "Zu Beginn geht es hier um die Läufer in der Rennbahn.", "asr_word_count": 11, "llm_duration": 3.816821336746216, "llm_text": "At the beginning, it refers here to the runners in the racecourse.", "llm_word_count": 12, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.3334650993347168, "tts_audio_size_bytes": 180300, "e2e_duration": 5.940232276916504, "rtf": 1.292, "timestamp": "2026-02-13T11:17:36.736657"}
{"correlation_id": "d376f7bf-2103-4b65-9ad9-345a4aab7a9d", "start_time": 1770981453.413468, "audio_duration_sec": 0.948, "asr_duration": 0.4677591323852539, "asr_confidence": 0.8810617108478903, "asr_text": "Und dann?", "asr_word_count": 2, "llm_duration": 1.7951383590698242, "llm_text": "And then?", "llm_word_count": 2, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.2247300148010254, "tts_audio_size_bytes": 155724, "e2e_duration": 5.009902238845825, "rtf": 5.285, "timestamp": "2026-02-13T11:17:38.423384"}
{"correlation_id": "f943d78c-e090-4014-9493-40d0af21bd65", "start_time": 1770981456.8251946, "audio_duration_sec": 2.388, "asr_duration": 0.42795729637145996, "asr_confidence": 0.7563153387667151, "asr_text": "lauft so, dass ihr", "asr_word_count": 4, "llm_duration": 1.9865615367889404, "llm_text": "run so that ye", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.713902473449707, "tts_audio_size_bytes": 81996, "e2e_duration": 3.129209041595459, "rtf": 1.31, "timestamp": "2026-02-13T11:17:39.954419"}
{"correlation_id": "e068de85-7850-4919-acc5-a1df16951299", "start_time": 1770981458.9260542, "audio_duration_sec": 1.78, "asr_duration": 0.4958944320678711, "asr_confidence": 0.8666118813031222, "asr_text": "den Sieg erlangt.", "asr_word_count": 3, "llm_duration": 1.9002025127410889, "llm_text": "achieved the victory.", "llm_word_count": 3, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.8024439811706543, "tts_audio_size_bytes": 115788, "e2e_duration": 3.1994924545288086, "rtf": 1.797, "timestamp": "2026-02-13T11:17:42.125560"}
{"correlation_id": "d0bb63b6-6d23-46eb-872c-5868d1f1aafd", "start_time": 1770981465.4464822, "audio_duration_sec": 2.356, "asr_duration": 0.624051570892334, "asr_confidence": 0.7479908128768159, "asr_text": "Die Aufforderung?", "asr_word_count": 2, "llm_duration": 1.5942256450653076, "llm_text": "The commandment?", "llm_word_count": 2, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.43200182914733887, "tts_audio_size_bytes": 57932, "e2e_duration": 2.650944709777832, "rtf": 1.125, "timestamp": "2026-02-13T11:17:48.097438"}
{"correlation_id": "160a571b-32f8-4d17-abf6-3ea008623784", "start_time": 1770981468.8565586, "audio_duration_sec": 2.836, "asr_duration": 0.5319094657897949, "asr_confidence": 0.9357506383666208, "asr_text": "die hat mich kalt erwischt in der Vorbereitung.", "asr_word_count": 8, "llm_duration": 2.6097776889801025, "llm_text": "it has caught me cold in the preparation.", "llm_word_count": 8, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.3826754093170166, "tts_audio_size_bytes": 119884, "e2e_duration": 4.52500057220459, "rtf": 1.596, "timestamp": "2026-02-13T11:17:53.381581"}
{"correlation_id": "d73c17fe-6e07-46c8-a41a-0377826437d9", "start_time": 1770981471.7222033, "audio_duration_sec": 1.876, "asr_duration": 0.7958366870880127, "asr_confidence": 0.8572686671894464, "asr_text": "Vielleicht geht es dir gerade ähnlich.", "asr_word_count": 6, "llm_duration": 2.5498595237731934, "llm_text": "Maybe thou art in the same case.", "llm_word_count": 7, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.7858884334564209, "tts_audio_size_bytes": 102476, "e2e_duration": 4.132393836975098, "rtf": 2.203, "timestamp": "2026-02-13T11:17:55.854607"}
{"correlation_id": "edc8c595-f29a-42fd-a6d1-97514c6e739e", "start_time": 1770981475.9045887, "audio_duration_sec": 2.804, "asr_duration": 0.5533947944641113, "asr_confidence": 0.9440976894523231, "asr_text": "Ich bin nämlich eher so der Typ Teilnehmerurkunde.", "asr_word_count": 8, "llm_duration": 2.93448543548584, "llm_text": "I am rather more of the type of participant certificate.", "llm_word_count": 10, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.4690635204315186, "tts_audio_size_bytes": 171596, "e2e_duration": 4.9576966762542725, "rtf": 1.768, "timestamp": "2026-02-13T11:18:00.862294"}
{"correlation_id": "de4bcebe-ad27-49ed-8e51-46ad1d575d3b", "start_time": 1770981484.535977, "audio_duration_sec": 6.228, "asr_duration": 0.9121522903442383, "asr_confidence": 0.9508902208579724, "asr_text": "Ja, nicht zu viel Zeit und vor allem nicht Kraft und Gedanken in irgendetwas investieren.", "asr_word_count": 15, "llm_duration": 5.220360279083252, "llm_text": "Yes, do not invest too much time and, above all, not too much strength and thoughts in anything.", "llm_word_count": 18, "src_lang": "de", "tgt_lang": "en", "tts_duration": 3.729797124862671, "tts_audio_size_bytes": 418892, "e2e_duration": 9.863038539886475, "rtf": 1.584, "timestamp": "2026-02-13T11:18:14.399027"}
{"correlation_id": "e81bb13b-7674-4c4e-b72e-c2b5862efaac", "start_time": 1770981488.9767175, "audio_duration_sec": 2.804, "asr_duration": 0.7539668083190918, "asr_confidence": 0.9153501044115828, "asr_text": "Ich muss ja schließlich auch noch entspannen.", "asr_word_count": 7, "llm_duration": 2.6754343509674072, "llm_text": "I must needs also rest.", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.100492000579834, "tts_audio_size_bytes": 135756, "e2e_duration": 6.53342342376709, "rtf": 2.33, "timestamp": "2026-02-13T11:18:15.510154"}
{"correlation_id": "5a624f18-bffb-48bc-a9bb-9b1aaf141fb3", "start_time": 1770981490.8149035, "audio_duration_sec": 1.428, "asr_duration": 0.6830217838287354, "asr_confidence": 0.7806500126975634, "asr_text": "und leben können.", "asr_word_count": 3, "llm_duration": 1.79982590675354, "llm_text": "and live.", "llm_word_count": 2, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.8110637664794922, "tts_audio_size_bytes": 111180, "e2e_duration": 5.509023427963257, "rtf": 3.858, "timestamp": "2026-02-13T11:18:16.323936"}
{"correlation_id": "b5c7ae91-bae9-47f1-b405-359fdb17acc1", "start_time": 1770981497.638706, "audio_duration_sec": 3.156, "asr_duration": 0.5499157905578613, "asr_confidence": 0.8607079781351309, "asr_text": "Wahrscheinlich fordert mich genau wegen dieser Philosophie.", "asr_word_count": 7, "llm_duration": 2.7315282821655273, "llm_text": "Probably it is this philosophy that challenges me.", "llm_word_count": 8, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.0706076622009277, "tts_audio_size_bytes": 137804, "e2e_duration": 4.353053331375122, "rtf": 1.379, "timestamp": "2026-02-13T11:18:21.991781"}
{"correlation_id": "488b4888-f4e9-47ed-9bc1-75d9206fc943", "start_time": 1770981500.2592974, "audio_duration_sec": 2.292, "asr_duration": 0.6172375679016113, "asr_confidence": 0.9054119600556131, "asr_text": "Diese Bibel stelle so sehr heraus.", "asr_word_count": 6, "llm_duration": 2.438321828842163, "llm_text": "This Bible stands out so much.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.649437665939331, "tts_audio_size_bytes": 93260, "e2e_duration": 3.7499918937683105, "rtf": 1.636, "timestamp": "2026-02-13T11:18:24.009298"}
{"correlation_id": "d48077a0-91c9-42b8-baea-e71d8bf63f40", "start_time": 1770981506.8319352, "audio_duration_sec": 4.308, "asr_duration": 0.7623898983001709, "asr_confidence": 0.946364997743352, "asr_text": "Weil mir das im ersten Moment ziemlich gegen den Strich geht, was hier steht.", "asr_word_count": 14, "llm_duration": 3.6018025875091553, "llm_text": "Because at first this goes against my heart, what is written here.", "llm_word_count": 12, "src_lang": "de", "tgt_lang": "en", "tts_duration": 2.494788885116577, "tts_audio_size_bytes": 204876, "e2e_duration": 6.8596508502960205, "rtf": 1.592, "timestamp": "2026-02-13T11:18:33.691596"}
{"correlation_id": "d02a1a00-e2f0-4d91-91e6-2e1360f4ba43", "start_time": 1770981511.5215213, "audio_duration_sec": 3.348, "asr_duration": 0.9893786907196045, "asr_confidence": 0.9526630181080589, "asr_text": "Wieso muss ich denn laufen, damit ich den Sieg erlange?", "asr_word_count": 10, "llm_duration": 3.5215275287628174, "llm_text": "Why must I run, that I might obtain the victory?", "llm_word_count": 10, "src_lang": "de", "tgt_lang": "en", "tts_duration": 2.324805498123169, "tts_audio_size_bytes": 180300, "e2e_duration": 6.836500883102417, "rtf": 2.042, "timestamp": "2026-02-13T11:18:38.358038"}
{"correlation_id": "a1453867-3557-44e0-9c12-557eefe33985", "start_time": 1770981522.0197818, "audio_duration_sec": 1.524, "asr_duration": 0.4225342273712158, "asr_confidence": 0.6077164475263447, "asr_text": "dir auf einmal.", "asr_word_count": 3, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "a1d06608-6880-4864-a4d0-c90a4e4fe4fe", "start_time": 1770981516.7831762, "audio_duration_sec": 4.148, "asr_duration": 1.2845101356506348, "asr_confidence": 0.9608412681678132, "asr_text": "Warum reicht es nicht, wenn ich mich irgendwie über die Ziellinie schleppe?", "asr_word_count": 12, "llm_duration": 4.675469875335693, "llm_text": "Why is it not enough for me to drag myself over the finish line in some way?", "llm_word_count": 17, "src_lang": "de", "tgt_lang": "en", "tts_duration": 2.2983715534210205, "tts_audio_size_bytes": 224844, "e2e_duration": 8.259074926376343, "rtf": 1.991, "timestamp": "2026-02-13T11:18:45.042269"}
{"correlation_id": "51a42cb4-ad02-42c6-9e27-2684d97df14a", "start_time": 1770981520.1878893, "audio_duration_sec": 1.716, "asr_duration": 0.6183633804321289, "asr_confidence": 0.9106437466904453, "asr_text": "Und was ist mit den Menschen?", "asr_word_count": 6, "llm_duration": 2.5724284648895264, "llm_text": "And what about the people?", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.6460857391357422, "tts_audio_size_bytes": 73292, "e2e_duration": 5.774847507476807, "rtf": 3.365, "timestamp": "2026-02-13T11:18:45.962753"}
{"correlation_id": "c054ec63-4865-4125-9770-3535129c2342", "start_time": 1770981523.3334732, "audio_duration_sec": 1.236, "asr_duration": 0.6120774745941162, "asr_confidence": 0.85606159325998, "asr_text": "verlieren würden.", "asr_word_count": 2, "llm_duration": 1.5684120655059814, "llm_text": "would lose.", "llm_word_count": 2, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.9204764366149902, "tts_audio_size_bytes": 53324, "e2e_duration": 4.472406387329102, "rtf": 3.618, "timestamp": "2026-02-13T11:18:47.805899"}
{"correlation_id": "9f606439-1fd2-49ef-96db-05b2b287ecf1", "start_time": 1770981527.0080256, "audio_duration_sec": 1.908, "asr_duration": 0.6697804927825928, "asr_confidence": 0.8993435246534164, "asr_text": "denn ich habe Olympia geschaut.", "asr_word_count": 5, "llm_duration": 2.3107872009277344, "llm_text": "for I have looked upon Olympia.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.4871799945831299, "tts_audio_size_bytes": 189004, "e2e_duration": 4.468462944030762, "rtf": 2.342, "timestamp": "2026-02-13T11:18:51.476503"}
{"correlation_id": "6d716b46-eed7-469d-93d8-489a25885056", "start_time": 1770981529.1125329, "audio_duration_sec": 1.972, "asr_duration": 0.44359564781188965, "asr_confidence": 0.8137885722161533, "asr_text": "Wahrscheinlich wie einige von euch.", "asr_word_count": 5, "llm_duration": 2.546405076980591, "llm_text": "Likely as some of you.", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.322624921798706, "tts_audio_size_bytes": 84556, "e2e_duration": 4.74613881111145, "rtf": 2.407, "timestamp": "2026-02-13T11:18:53.858680"}
{"correlation_id": "3336e8bd-c2f9-410f-8a93-89dd90e435e1", "start_time": 1770981533.840013, "audio_duration_sec": 0.596, "asr_duration": 0.3971271514892578, "asr_confidence": 0.51859055164918, "asr_text": "Amen.", "asr_word_count": 1, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "90b3f805-6acd-46b4-b3c4-189d96f0f3de", "start_time": 1770981532.795705, "audio_duration_sec": 3.188, "asr_duration": 1.1207170486450195, "asr_confidence": 0.9077359428147278, "asr_text": "Da bekommt am Ende nur eine Person die Goldmedaille.", "asr_word_count": 9, "llm_duration": 3.280092477798462, "llm_text": "At the end, only one person receives the gold medal.", "llm_word_count": 10, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.6286053657531738, "tts_audio_size_bytes": 180300, "e2e_duration": 6.030059337615967, "rtf": 1.891, "timestamp": "2026-02-13T11:18:58.825775"}
{"correlation_id": "ad4f9a77-2928-4016-8ec0-dc8f862def5f", "start_time": 1770981539.074548, "audio_duration_sec": 2.036, "asr_duration": 0.5214743614196777, "asr_confidence": 0.8344828513691535, "asr_text": "Ich glaube, in den wenigen Versen hier...", "asr_word_count": 7, "llm_duration": 2.2091562747955322, "llm_text": "I believe in these few verses...", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 2.1836979389190674, "tts_audio_size_bytes": 191564, "e2e_duration": 4.915136098861694, "rtf": 2.414, "timestamp": "2026-02-13T11:19:03.989700"}
{"correlation_id": "2f3f1529-f2ff-4e41-b067-22612a653080", "start_time": 1770981541.9504077, "audio_duration_sec": 2.58, "asr_duration": 0.8429524898529053, "asr_confidence": 0.9230442286230622, "asr_text": "geht es nicht per se um das Gewinnen.", "asr_word_count": 8, "llm_duration": 2.44012188911438, "llm_text": "it is not inherently about winning.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.917534351348877, "tts_audio_size_bytes": 135756, "e2e_duration": 4.201341152191162, "rtf": 1.628, "timestamp": "2026-02-13T11:19:06.151765"}
{"correlation_id": "43724599-aca5-4269-af9c-347303ec6ad2", "start_time": 1770981546.4173965, "audio_duration_sec": 2.388, "asr_duration": 0.579878568649292, "asr_confidence": 0.9154374804707606, "asr_text": "Und wenn ihr mich fragt, schon gar nicht ums Verlieren.", "asr_word_count": 10, "llm_duration": 3.3470723628997803, "llm_text": "And if I am asked, not at all for the losing.", "llm_word_count": 11, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.2771964073181152, "tts_audio_size_bytes": 153676, "e2e_duration": 5.204801559448242, "rtf": 2.18, "timestamp": "2026-02-13T11:19:11.622208"}
{"correlation_id": "895f5473-05cd-4198-bf18-89560dcaa54c", "start_time": 1770981552.154839, "audio_duration_sec": 3.604, "asr_duration": 0.6035292148590088, "asr_confidence": 0.8648053533782524, "asr_text": "Ich glaube, an dieser Stelle geht es vielmehr um die Haltung.", "asr_word_count": 11, "llm_duration": 2.944765090942383, "llm_text": "I believe it is more about the attitude here.", "llm_word_count": 9, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.9924476146697998, "tts_audio_size_bytes": 126540, "e2e_duration": 4.541385173797607, "rtf": 1.26, "timestamp": "2026-02-13T11:19:16.696239"}
{"correlation_id": "c9262428-3b97-49e1-a807-1783fc211013", "start_time": 1770981557.1394389, "audio_duration_sec": 0.948, "asr_duration": 0.3757359981536865, "asr_confidence": 0.5987622776485136, "asr_text": "Vielleicht.", "asr_word_count": 1, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "94552ad9-ef82-485a-b0b2-771f709b3143", "start_time": 1770981554.2459013, "audio_duration_sec": 1.908, "asr_duration": 0.45510101318359375, "asr_confidence": 0.9241921910641856, "asr_text": "die wir in unserem Leben einnehmen.", "asr_word_count": 6, "llm_duration": 2.506201982498169, "llm_text": "that we take into our lives.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.653937578201294, "tts_audio_size_bytes": 95820, "e2e_duration": 4.618352651596069, "rtf": 2.421, "timestamp": "2026-02-13T11:19:18.864264"}
{"correlation_id": "11a4a20f-7481-4cde-8c12-155c5c4c506c", "start_time": 1770981561.604442, "audio_duration_sec": 0.468, "asr_duration": 0.3745450973510742, "asr_confidence": 0.4476646091169132, "asr_text": "Und", "asr_word_count": 1, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "d88822b6-5f5e-4df2-b636-f4dd0eb0d673", "start_time": 1770981559.774137, "audio_duration_sec": 2.132, "asr_duration": 0.5135233402252197, "asr_confidence": 0.9279505935606094, "asr_text": "habe ich es mir etwas zu bequem gemacht.", "asr_word_count": 8, "llm_duration": 2.102013349533081, "llm_text": "have I grown complacent?", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.5858089923858643, "tts_audio_size_bytes": 88652, "e2e_duration": 3.202057123184204, "rtf": 1.502, "timestamp": "2026-02-13T11:19:22.976204"}
{"correlation_id": "2e98f2f6-ad8f-4612-82cd-a3822276f43b", "start_time": 1770981564.7641895, "audio_duration_sec": 3.06, "asr_duration": 0.6994409561157227, "asr_confidence": 0.956227794948359, "asr_text": "und genieße das Leben in vollen Zügen.", "asr_word_count": 7, "llm_duration": 2.2389795780181885, "llm_text": "and enjoy life to the fullest.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.6852288246154785, "tts_audio_size_bytes": 137804, "e2e_duration": 4.6253273487091064, "rtf": 1.512, "timestamp": "2026-02-13T11:19:29.389526"}
{"correlation_id": "4e25c163-f4cd-41d5-9604-fe87e227ec98", "start_time": 1770981567.6364338, "audio_duration_sec": 2.804, "asr_duration": 0.8481345176696777, "asr_confidence": 0.8984563042007793, "asr_text": "Und lasse in ruhigen Momenten meine Gedanken schweifen.", "asr_word_count": 8, "llm_duration": 2.8271303176879883, "llm_text": "And let my thoughts wander in quiet moments.", "llm_word_count": 8, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.0472993850708008, "tts_audio_size_bytes": 126540, "e2e_duration": 4.723341226577759, "rtf": 1.685, "timestamp": "2026-02-13T11:19:32.359785"}
{"correlation_id": "1759b302-db41-4629-b3bd-6b2df9ee0078", "start_time": 1770981572.6379356, "audio_duration_sec": 2.804, "asr_duration": 0.5344986915588379, "asr_confidence": 0.8519066538353742, "asr_text": "wann ich wohl das nächste Mal in den Urlaub gehen werde.", "asr_word_count": 11, "llm_duration": 2.7261130809783936, "llm_text": "when I shall perhaps go on vacation next.", "llm_word_count": 8, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.182457685470581, "tts_audio_size_bytes": 149068, "e2e_duration": 4.443680047988892, "rtf": 1.585, "timestamp": "2026-02-13T11:19:37.081630"}
{"correlation_id": "9991ac2a-b0a8-4fae-8634-21f250463c9b", "start_time": 1770981574.9862442, "audio_duration_sec": 1.684, "asr_duration": 0.5420186519622803, "asr_confidence": 0.8468675766936923, "asr_text": "wo die Reise hingeht.", "asr_word_count": 4, "llm_duration": 2.0888800621032715, "llm_text": "where the journey leads.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.0209136009216309, "tts_audio_size_bytes": 84556, "e2e_duration": 4.023043394088745, "rtf": 2.389, "timestamp": "2026-02-13T11:19:39.009305"}
{"correlation_id": "b57b509d-59b8-4333-9edb-6a54d87eb58a", "start_time": 1770981578.3995314, "audio_duration_sec": 2.356, "asr_duration": 0.7054626941680908, "asr_confidence": 0.8323551320799828, "asr_text": "Italien, Kroatien.", "asr_word_count": 2, "llm_duration": 1.592686653137207, "llm_text": "Italy, Croatia.", "llm_word_count": 2, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.7071065902709961, "tts_audio_size_bytes": 111180, "e2e_duration": 3.0061726570129395, "rtf": 1.276, "timestamp": "2026-02-13T11:19:41.405712"}
{"correlation_id": "50749df4-a685-47c1-8cd2-f1f9299cba1c", "start_time": 1770981582.350201, "audio_duration_sec": 2.1, "asr_duration": 0.4665536880493164, "asr_confidence": 0.9229622854776471, "asr_text": "wann ich das nächste Mal essen gehe.", "asr_word_count": 7, "llm_duration": 2.2822461128234863, "llm_text": "when I go to eat again.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.5702450275421143, "tts_audio_size_bytes": 75340, "e2e_duration": 3.3197271823883057, "rtf": 1.581, "timestamp": "2026-02-13T11:19:45.669939"}
{"correlation_id": "fb31a389-c7f2-455e-bc45-9ad837e912b9", "start_time": 1770981583.923506, "audio_duration_sec": 0.98, "asr_duration": 0.39805030822753906, "asr_confidence": 0.9400685719592775, "asr_text": "Und wohin?", "asr_word_count": 2, "llm_duration": 1.7344613075256348, "llm_text": "And whither?", "llm_word_count": 2, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.5622584819793701, "tts_audio_size_bytes": 84556, "e2e_duration": 3.4732367992401123, "rtf": 3.544, "timestamp": "2026-02-13T11:19:47.396753"}
{"correlation_id": "5270dd80-a393-40e7-90ec-67cf45800bf2", "start_time": 1770981587.6095593, "audio_duration_sec": 2.164, "asr_duration": 0.5439574718475342, "asr_confidence": 0.9009703551249587, "asr_text": "was ich mir da Leckeres bestellen werde.", "asr_word_count": 7, "llm_duration": 2.4624016284942627, "llm_text": "what delicacies I shall order there.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.820328950881958, "tts_audio_size_bytes": 109132, "e2e_duration": 3.8273801803588867, "rtf": 1.769, "timestamp": "2026-02-13T11:19:51.436958"}
{"correlation_id": "535c455b-4063-4efd-9b22-d0304ba3f5ff", "start_time": 1770981589.9478834, "audio_duration_sec": 0.916, "asr_duration": 0.6051466464996338, "asr_confidence": 0.7169979613209179, "asr_text": "Ach ja.", "asr_word_count": 2, "llm_duration": 1.589792251586914, "llm_text": "And lo.", "llm_word_count": 2, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.3788762092590332, "tts_audio_size_bytes": 55372, "e2e_duration": 2.6377241611480713, "rtf": 2.88, "timestamp": "2026-02-13T11:19:52.585617"}
{"correlation_id": "a5444fad-dc3a-4ef7-8718-bfc417606f0c", "start_time": 1770981592.5631213, "audio_duration_sec": 1.492, "asr_duration": 0.43924880027770996, "asr_confidence": 0.8827123822325507, "asr_text": "Das Leben ist gut.", "asr_word_count": 4, "llm_duration": 1.5630784034729004, "llm_text": "Life is good.", "llm_word_count": 3, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.8977177143096924, "tts_audio_size_bytes": 129100, "e2e_duration": 2.9007091522216797, "rtf": 1.944, "timestamp": "2026-02-13T11:19:55.463840"}
{"correlation_id": "1c85b80a-738e-402a-b579-aa27f8e52e7e", "start_time": 1770981598.0879996, "audio_duration_sec": 2.932, "asr_duration": 0.6128249168395996, "asr_confidence": 0.937763198842024, "asr_text": "Tut mir leid, dass ich uns aus diesem schönen Gedanken rausreiße.", "asr_word_count": 11, "llm_duration": 3.723945379257202, "llm_text": "I am sorry that I am pulling us out of this beautiful thought.", "llm_word_count": 13, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.052785873413086, "tts_audio_size_bytes": 144460, "e2e_duration": 5.390272617340088, "rtf": 1.838, "timestamp": "2026-02-13T11:20:03.478283"}
{"correlation_id": "dfdc30a0-f294-4628-bd09-ba0f96dd9e30", "start_time": 1770981601.4955099, "audio_duration_sec": 3.028, "asr_duration": 0.7999711036682129, "asr_confidence": 0.940688085086795, "asr_text": "Aber ich möchte zu Beginn ein paar Grundüberzeugungen anstellen.", "asr_word_count": 9, "llm_duration": 3.7615997791290283, "llm_text": "But I want at the beginning to state a few foundational convictions.", "llm_word_count": 12, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.9777722358703613, "tts_audio_size_bytes": 213580, "e2e_duration": 6.669704437255859, "rtf": 2.203, "timestamp": "2026-02-13T11:20:08.165229"}
{"correlation_id": "c5b8b910-b74f-438a-bd0b-367891719bd3", "start_time": 1770981605.6956277, "audio_duration_sec": 3.124, "asr_duration": 0.953007698059082, "asr_confidence": 0.8093934267234685, "asr_text": "Ich glaube nicht, dass wir leben,", "asr_word_count": 6, "llm_duration": 2.775458812713623, "llm_text": "I do not believe that we live.", "llm_word_count": 7, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.658294677734375, "tts_audio_size_bytes": 95820, "e2e_duration": 4.387563705444336, "rtf": 1.404, "timestamp": "2026-02-13T11:20:10.083201"}
{"correlation_id": "57f9f321-e405-44bf-ad02-43495da928e0", "start_time": 1770981610.4027174, "audio_duration_sec": 4.244, "asr_duration": 0.5974099636077881, "asr_confidence": 0.9508114968340501, "asr_text": "um unseren Wohlstand zu genießen und Tag für Tag verstreichen zu lassen.", "asr_word_count": 12, "llm_duration": 3.991577625274658, "llm_text": "that we may enjoy our prosperity and let each day pass as it will.", "llm_word_count": 14, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.7920730113983154, "tts_audio_size_bytes": 229452, "e2e_duration": 6.381744623184204, "rtf": 1.504, "timestamp": "2026-02-13T11:20:16.784477"}
{"correlation_id": "83aa488d-3dc5-4a52-b474-5e5883e1ae1d", "start_time": 1770981613.5450602, "audio_duration_sec": 2.068, "asr_duration": 0.6592385768890381, "asr_confidence": 0.8634229720969256, "asr_text": "Ich glaube auch nicht.", "asr_word_count": 4, "llm_duration": 2.261258840560913, "llm_text": "I also believe not.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.9471333026885986, "tts_audio_size_bytes": 81996, "e2e_duration": 4.65606427192688, "rtf": 2.251, "timestamp": "2026-02-13T11:20:18.201134"}
{"correlation_id": "295027b9-ff65-4e2b-841b-2e23c53edd8c", "start_time": 1770981617.721901, "audio_duration_sec": 3.476, "asr_duration": 0.6559536457061768, "asr_confidence": 0.9462610323820693, "asr_text": "dass wir leben, um jede Woche 80 Stunden lang zu arbeiten.", "asr_word_count": 11, "llm_duration": 3.378995656967163, "llm_text": "that we live to work 80 hours a week.", "llm_word_count": 9, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.8970966339111328, "tts_audio_size_bytes": 115788, "e2e_duration": 4.932770252227783, "rtf": 1.419, "timestamp": "2026-02-13T11:20:22.654681"}
{"correlation_id": "e3ef4016-d05c-4236-b489-df10fec39a85", "start_time": 1770981620.601872, "audio_duration_sec": 2.804, "asr_duration": 0.6807725429534912, "asr_confidence": 0.9595128988169552, "asr_text": "um in der Gesellschaft als erfolgreich angesehen zu werden.", "asr_word_count": 9, "llm_duration": 2.929830551147461, "llm_text": "in order to be considered successful in society.", "llm_word_count": 8, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.5091280937194824, "tts_audio_size_bytes": 195660, "e2e_duration": 5.594989776611328, "rtf": 1.995, "timestamp": "2026-02-13T11:20:26.196880"}
{"correlation_id": "73a63587-0840-45ac-9973-60f501e1335b", "start_time": 1770981623.7547624, "audio_duration_sec": 1.46, "asr_duration": 0.4281446933746338, "asr_confidence": 0.7791388776105161, "asr_text": "Wenn ihr mich fragt,", "asr_word_count": 4, "llm_duration": 2.613046646118164, "llm_text": "If I may be so bold,", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.1496186256408691, "tts_audio_size_bytes": 84556, "e2e_duration": 4.695974111557007, "rtf": 3.216, "timestamp": "2026-02-13T11:20:28.450748"}
{"correlation_id": "2c018512-29b0-4b52-ba89-d5f00c27c5c0", "start_time": 1770981627.1792803, "audio_duration_sec": 2.58, "asr_duration": 0.9547789096832275, "asr_confidence": 0.9025428934825543, "asr_text": "Dann leben wir, um nachzufolgen.", "asr_word_count": 5, "llm_duration": 2.093651056289673, "llm_text": "Then we live to follow.", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.643164873123169, "tts_audio_size_bytes": 71244, "e2e_duration": 3.6925432682037354, "rtf": 1.431, "timestamp": "2026-02-13T11:20:30.871833"}
{"correlation_id": "10308409-bbee-4135-950a-68d98fe8c770", "start_time": 1770981630.85577, "audio_duration_sec": 1.268, "asr_duration": 0.4551393985748291, "asr_confidence": 0.8097258298238204, "asr_text": "und nachfolgen.", "asr_word_count": 2, "llm_duration": 1.4035999774932861, "llm_text": "and follow.", "llm_word_count": 2, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.39397311210632324, "tts_audio_size_bytes": 53324, "e2e_duration": 2.2534046173095703, "rtf": 1.777, "timestamp": "2026-02-13T11:20:33.109184"}
{"correlation_id": "5bc15d5b-c83b-489f-8c08-e4c224ce2127", "start_time": 1770981633.7348897, "audio_duration_sec": 2.452, "asr_duration": 0.49016404151916504, "asr_confidence": 0.8715059769535066, "asr_text": "fühlt sich manchmal wie ein Kampf an.", "asr_word_count": 7, "llm_duration": 2.5635673999786377, "llm_text": "feels like a battle at times.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.7316458225250244, "tts_audio_size_bytes": 91212, "e2e_duration": 3.7861077785491943, "rtf": 1.544, "timestamp": "2026-02-13T11:20:37.521007"}
{"correlation_id": "01ff5d02-a210-4141-ae1f-c266b9780d2d", "start_time": 1770981635.547987, "audio_duration_sec": 1.94, "asr_duration": 0.5072176456451416, "asr_confidence": 0.8908092167803938, "asr_text": "Da haben wir es gerade in einem Lied gesungen.", "asr_word_count": 9, "llm_duration": 2.9078400135040283, "llm_text": "Just now we sang it in a song.", "llm_word_count": 8, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.7234082221984863, "tts_audio_size_bytes": 95820, "e2e_duration": 4.87295126914978, "rtf": 2.512, "timestamp": "2026-02-13T11:20:40.420947"}
{"correlation_id": "554668a8-0c7d-4d05-835e-f90f419533e0", "start_time": 1770981637.9147997, "audio_duration_sec": 2.036, "asr_duration": 0.5029850006103516, "asr_confidence": 0.8771126938202922, "asr_text": "Wenn ich kämpfe, dann auf meinen Knien.", "asr_word_count": 7, "llm_duration": 2.9350626468658447, "llm_text": "When I fight, then on my knees.", "llm_word_count": 7, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.0896518230438232, "tts_audio_size_bytes": 142412, "e2e_duration": 5.807793140411377, "rtf": 2.853, "timestamp": "2026-02-13T11:20:43.722605"}
{"correlation_id": "14ee4c04-151c-47ba-9f59-6cdd253670f2", "start_time": 1770981641.0661862, "audio_duration_sec": 2.708, "asr_duration": 0.5618927478790283, "asr_confidence": 0.9500483473966348, "asr_text": "Und so lese ich das auch aus dieser Bibelstelle heraus.", "asr_word_count": 10, "llm_duration": 3.092427968978882, "llm_text": "And so I also read this from this scripture.", "llm_word_count": 9, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.7715413570404053, "tts_audio_size_bytes": 166988, "e2e_duration": 6.43103289604187, "rtf": 2.375, "timestamp": "2026-02-13T11:20:47.497229"}
{"correlation_id": "43d18883-f713-4a22-b68b-1d6c6a7ddf80", "start_time": 1770981646.8323915, "audio_duration_sec": 2.356, "asr_duration": 0.7402675151824951, "asr_confidence": 0.9372367754134558, "asr_text": "Auf einen Satz folgt der nächste.", "asr_word_count": 6, "llm_duration": 2.1864521503448486, "llm_text": "In one sentence follows another.", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.9567279815673828, "tts_audio_size_bytes": 124492, "e2e_duration": 3.884087562561035, "rtf": 1.649, "timestamp": "2026-02-13T11:20:50.716489"}
{"correlation_id": "cdc92108-fe2c-4a0a-befd-f65b76c761b1", "start_time": 1770981649.1966407, "audio_duration_sec": 2.004, "asr_duration": 0.47354817390441895, "asr_confidence": 0.8260903460530027, "asr_text": "Jeder aber, der kämpft,", "asr_word_count": 4, "llm_duration": 2.3552558422088623, "llm_text": "But every one who fights,", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.952277421951294, "tts_audio_size_bytes": 131148, "e2e_duration": 3.8709936141967773, "rtf": 1.932, "timestamp": "2026-02-13T11:20:53.067645"}
{"correlation_id": "b934e25f-4171-4f73-a104-810cc23bae6a", "start_time": 1770981651.5609121, "audio_duration_sec": 1.844, "asr_duration": 0.43169140815734863, "asr_confidence": 0.741686870386346, "asr_text": "ist enthaltsam.", "asr_word_count": 2, "llm_duration": 1.960996150970459, "llm_text": "It is fruitful.", "llm_word_count": 3, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.084449291229248, "tts_audio_size_bytes": 135756, "e2e_duration": 3.6002585887908936, "rtf": 1.952, "timestamp": "2026-02-13T11:20:55.161183"}
{"correlation_id": "ba595691-f240-4327-9bab-f3cece3d5666", "start_time": 1770981653.130408, "audio_duration_sec": 1.236, "asr_duration": 0.3893015384674072, "asr_confidence": 0.7256858866254617, "asr_text": "In allem.", "asr_word_count": 2, "llm_duration": 1.8042068481445312, "llm_text": "In all things.", "llm_word_count": 3, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.5327231884002686, "tts_audio_size_bytes": 64588, "e2e_duration": 3.2835869789123535, "rtf": 2.657, "timestamp": "2026-02-13T11:20:56.414004"}
{"correlation_id": "082be10d-8b30-45bb-9682-9c82b5fa23b8", "start_time": 1770981660.4713438, "audio_duration_sec": 3.06, "asr_duration": 0.9103209972381592, "asr_confidence": 0.9223148085525036, "asr_text": "Wenn man mal ein bisschen hinter die Kulissen von Profisportlern schaut.", "asr_word_count": 11, "llm_duration": 3.383477210998535, "llm_text": "If one peeks behind the scenes of professional athletes.", "llm_word_count": 9, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.3790099620819092, "tts_audio_size_bytes": 169036, "e2e_duration": 5.673462390899658, "rtf": 1.854, "timestamp": "2026-02-13T11:21:06.144820"}
{"correlation_id": "f5c4e5f9-7661-431c-b5ba-2ca69cc650f2", "start_time": 1770981662.5677567, "audio_duration_sec": 2.26, "asr_duration": 0.5396544933319092, "asr_confidence": 0.964276737611504, "asr_text": "Ich bin keiner, aber ich habe es gegoogelt.", "asr_word_count": 8, "llm_duration": 3.752821207046509, "llm_text": "I am not one, but I have looked it up.", "llm_word_count": 10, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.0577425956726074, "tts_audio_size_bytes": 137804, "e2e_duration": 7.008944272994995, "rtf": 3.101, "timestamp": "2026-02-13T11:21:09.576712"}
{"correlation_id": "5b164741-122d-42ce-88a6-47e8b2f27108", "start_time": 1770981664.4064505, "audio_duration_sec": 1.46, "asr_duration": 0.4994354248046875, "asr_confidence": 0.8410799346422111, "asr_text": "Da merkt man schnell,", "asr_word_count": 4, "llm_duration": 1.8775265216827393, "llm_text": "One soon realizes,", "llm_word_count": 3, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.6060254573822021, "tts_audio_size_bytes": 84556, "e2e_duration": 6.596399784088135, "rtf": 4.518, "timestamp": "2026-02-13T11:21:11.002861"}
{"correlation_id": "e24e004d-4697-4418-95fe-4124a910f631", "start_time": 1770981667.032965, "audio_duration_sec": 2.548, "asr_duration": 0.5113143920898438, "asr_confidence": 0.8551226152262554, "asr_text": "Die Anstrengung während eines Wettkampfs", "asr_word_count": 5, "llm_duration": 1.9489808082580566, "llm_text": "The effort during a contest", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.7534191608428955, "tts_audio_size_bytes": 102476, "e2e_duration": 7.066607475280762, "rtf": 2.773, "timestamp": "2026-02-13T11:21:14.099584"}
{"correlation_id": "b5e32178-0f5f-4b19-8f9c-1c7b795f9ecf", "start_time": 1770981672.5224345, "audio_duration_sec": 4.532, "asr_duration": 1.348318338394165, "asr_confidence": 0.9608130989440475, "asr_text": "die reicht noch lange nicht aus, um als erstes über die Ziellinie zu laufen.", "asr_word_count": 14, "llm_duration": 4.575584173202515, "llm_text": "theirs is not sufficient to enable them to be the first to cross the finish line.", "llm_word_count": 16, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.6386220455169678, "tts_audio_size_bytes": 204876, "e2e_duration": 7.563242435455322, "rtf": 1.669, "timestamp": "2026-02-13T11:21:20.085688"}
{"correlation_id": "fdb5b96d-70fd-4562-a458-1c3ea871130a", "start_time": 1770981682.4548206, "audio_duration_sec": 1.844, "asr_duration": 0.6599600315093994, "asr_confidence": 0.6825329706504875, "asr_text": "Diesem einen Lauf...", "asr_word_count": 3, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "a0ae7647-ae5f-43d2-9f82-6f4afc33a336", "start_time": 1770981680.0927775, "audio_duration_sec": 3.444, "asr_duration": 0.5548486709594727, "asr_confidence": 0.9393557251530533, "asr_text": "Es handelt sich nicht um eine Eintagesleistung.", "asr_word_count": 7, "llm_duration": 2.586632251739502, "llm_text": "It is not a one-day effort.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.7501349449157715, "tts_audio_size_bytes": 119884, "e2e_duration": 3.892237663269043, "rtf": 1.13, "timestamp": "2026-02-13T11:21:23.985026"}
{"correlation_id": "0dc959e9-b97f-48ca-8aef-b87167d9d2fb", "start_time": 1770981687.7090778, "audio_duration_sec": 5.108, "asr_duration": 0.5465836524963379, "asr_confidence": 0.9258170046481028, "asr_text": "gehen mehrere Jahre an hartem Training voraus.", "asr_word_count": 7, "llm_duration": 2.038905620574951, "llm_text": "through much affliction arise.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.6773078441619873, "tts_audio_size_bytes": 104524, "e2e_duration": 3.263439893722534, "rtf": 0.639, "timestamp": "2026-02-13T11:21:30.972527"}
{"correlation_id": "7515e683-4da4-41d7-9bcd-b12dd73b1048", "start_time": 1770981691.3749616, "audio_duration_sec": 2.516, "asr_duration": 0.5140776634216309, "asr_confidence": 0.9016619369631944, "asr_text": "Es ist keine Eintagesleistung.", "asr_word_count": 4, "llm_duration": 2.45823335647583, "llm_text": "It is not a one-day achievement.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.7861268520355225, "tts_audio_size_bytes": 99916, "e2e_duration": 3.7590701580047607, "rtf": 1.494, "timestamp": "2026-02-13T11:21:35.134041"}
{"correlation_id": "7e8e1b21-be33-4fc7-ac3d-a3b3ea3790db", "start_time": 1770981697.6646693, "audio_duration_sec": 5.076, "asr_duration": 0.8964211940765381, "asr_confidence": 0.9354328434743225, "asr_text": "Viele Athleten widmen sich mit ihrem gesamten Leben, auch das haben wir vorhin gehört,", "asr_word_count": 14, "llm_duration": 3.987616539001465, "llm_text": "Many athletes devote their entire lives to it, as we heard just now.", "llm_word_count": 13, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.9938113689422607, "tts_audio_size_bytes": 216140, "e2e_duration": 6.878495693206787, "rtf": 1.355, "timestamp": "2026-02-13T11:21:44.543179"}
{"correlation_id": "c225c3bd-ad65-44be-ac74-a269e768f687", "start_time": 1770981701.3393776, "audio_duration_sec": 2.772, "asr_duration": 0.7398436069488525, "asr_confidence": 0.9302837572908204, "asr_text": "diesem einen Lauf oder diesem einen Wettkampf.", "asr_word_count": 7, "llm_duration": 2.9625244140625, "llm_text": "this one race or this one contest.", "llm_word_count": 7, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.8144583702087402, "tts_audio_size_bytes": 224844, "e2e_duration": 5.987291574478149, "rtf": 2.16, "timestamp": "2026-02-13T11:21:47.326693"}
{"correlation_id": "7f9a7c18-1509-4d79-a903-378847522a1d", "start_time": 1770981704.2266152, "audio_duration_sec": 1.556, "asr_duration": 0.46921682357788086, "asr_confidence": 0.7265525652861898, "asr_text": "wie viel Zeit es ist.", "asr_word_count": 5, "llm_duration": 2.4595396518707275, "llm_text": "how much time it is.", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.5158789157867432, "tts_audio_size_bytes": 77900, "e2e_duration": 4.261353015899658, "rtf": 2.739, "timestamp": "2026-02-13T11:21:48.487980"}
{"correlation_id": "3b1f8261-bb38-4156-bb2b-2a0f83fa25e2", "start_time": 1770981709.2054136, "audio_duration_sec": 2.676, "asr_duration": 0.5218029022216797, "asr_confidence": 0.9250746348099225, "asr_text": "Und da überleben sie nach ganz klaren Strukturen.", "asr_word_count": 8, "llm_duration": 2.469752073287964, "llm_text": "And they shall live after clear structures.", "llm_word_count": 7, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.6571507453918457, "tts_audio_size_bytes": 111180, "e2e_duration": 4.649534463882446, "rtf": 1.737, "timestamp": "2026-02-13T11:21:53.854959"}
{"correlation_id": "cacdb6db-c75e-4bd8-9c6f-ccee44d60cb1", "start_time": 1770981712.3517787, "audio_duration_sec": 1.492, "asr_duration": 0.8182299137115479, "asr_confidence": 0.7532329830065024, "asr_text": "in ihrem Schlafrhythmus.", "asr_word_count": 3, "llm_duration": 2.019148349761963, "llm_text": "in their sleep rhythm.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.6198768615722656, "tts_audio_size_bytes": 86604, "e2e_duration": 3.457930564880371, "rtf": 2.318, "timestamp": "2026-02-13T11:21:55.809717"}
{"correlation_id": "b3a1006e-2a20-47dc-8cdd-fa7aa9405f0a", "start_time": 1770981716.5491798, "audio_duration_sec": 3.572, "asr_duration": 0.6014194488525391, "asr_confidence": 0.8940337828119783, "asr_text": "Sie achten sehr darauf, mindestens 8 Stunden pro Nacht zu schlafen.", "asr_word_count": 11, "llm_duration": 3.9423837661743164, "llm_text": "You are to take great care to sleep at least eight hours each night.", "llm_word_count": 14, "src_lang": "de", "tgt_lang": "en", "tts_duration": 2.271892786026001, "tts_audio_size_bytes": 220236, "e2e_duration": 6.816394567489624, "rtf": 1.908, "timestamp": "2026-02-13T11:22:03.365587"}
{"correlation_id": "1e3e79a1-ae4f-4b2e-845b-661f4d23b13d", "start_time": 1770981719.687954, "audio_duration_sec": 2.164, "asr_duration": 0.6935153007507324, "asr_confidence": 0.7576295266878885, "asr_text": "In ihrem Tagesablauf.", "asr_word_count": 3, "llm_duration": 2.431060552597046, "llm_text": "In their daily routine.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.5852551460266113, "tts_audio_size_bytes": 79948, "e2e_duration": 4.422386884689331, "rtf": 2.044, "timestamp": "2026-02-13T11:22:04.110350"}
{"correlation_id": "c528a938-4dd0-47c6-a142-7e8d48e9fc29", "start_time": 1770981722.0415258, "audio_duration_sec": 1.652, "asr_duration": 0.6798839569091797, "asr_confidence": 0.8112098373156931, "asr_text": "Mit mindestens zwei.", "asr_word_count": 3, "llm_duration": 2.1030702590942383, "llm_text": "With at least two.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.4930572509765625, "tts_audio_size_bytes": 66636, "e2e_duration": 4.08001184463501, "rtf": 2.47, "timestamp": "2026-02-13T11:22:06.121547"}
{"correlation_id": "2183871c-48cc-4104-9052-dcf67526b444", "start_time": 1770981724.6625674, "audio_duration_sec": 2.42, "asr_duration": 0.48238182067871094, "asr_confidence": 0.8195161363808059, "asr_text": "wenn nicht sogar drei Trainingseinheiten.", "asr_word_count": 5, "llm_duration": 2.5759360790252686, "llm_text": "if not even three training sessions.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.6175777912139893, "tts_audio_size_bytes": 135756, "e2e_duration": 5.159761667251587, "rtf": 2.132, "timestamp": "2026-02-13T11:22:09.822342"}
{"correlation_id": "d1d90b80-98d1-4d45-a6dd-7b55b91fe9dc", "start_time": 1770981726.4976907, "audio_duration_sec": 1.684, "asr_duration": 0.4521322250366211, "asr_confidence": 0.8672891837885106, "asr_text": "Eine am Vormittag.", "asr_word_count": 3, "llm_duration": 2.1113507747650146, "llm_text": "In the morning.", "llm_word_count": 3, "src_lang": "de", "tgt_lang": "en", "tts_duration": 2.5194880962371826, "tts_audio_size_bytes": 320588, "e2e_duration": 6.338238716125488, "rtf": 3.764, "timestamp": "2026-02-13T11:22:12.835941"}
{"correlation_id": "3ee8d102-0829-4e01-ad81-580c91436e54", "start_time": 1770981729.1091866, "audio_duration_sec": 2.324, "asr_duration": 0.7857890129089355, "asr_confidence": 0.8239557943221998, "asr_text": "1 bis 2 am Mittag und Nachmittag.", "asr_word_count": 7, "llm_duration": 3.56540846824646, "llm_text": "1 And 2 in the morning and evening.", "llm_word_count": 8, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.917712926864624, "tts_audio_size_bytes": 124492, "e2e_duration": 5.690709829330444, "rtf": 2.449, "timestamp": "2026-02-13T11:22:14.799907"}
{"correlation_id": "ca59bcc2-debe-430f-993c-e96a384aca57", "start_time": 1770981732.7813325, "audio_duration_sec": 1.908, "asr_duration": 0.4569978713989258, "asr_confidence": 0.7820186136402321, "asr_text": "In ihrer Regeneration.", "asr_word_count": 3, "llm_duration": 1.8611476421356201, "llm_text": "In their regeneration.", "llm_word_count": 3, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.5834324359893799, "tts_audio_size_bytes": 91212, "e2e_duration": 3.545788288116455, "rtf": 1.858, "timestamp": "2026-02-13T11:22:16.327141"}
{"correlation_id": "4eb5d76f-e67a-4899-886f-1abebe6999e2", "start_time": 1770981736.7184274, "audio_duration_sec": 3.188, "asr_duration": 0.5443434715270996, "asr_confidence": 0.894918208102478, "asr_text": "Durch fest eingeplante Dehn- und Ruhezeiten", "asr_word_count": 6, "llm_duration": 2.3147153854370117, "llm_text": "Through fixed stretch and rest periods", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.0333137512207031, "tts_audio_size_bytes": 131148, "e2e_duration": 3.893087148666382, "rtf": 1.221, "timestamp": "2026-02-13T11:22:20.611533"}
{"correlation_id": "e3e5b86c-2220-4828-a7c4-088693a2357c", "start_time": 1770981738.800622, "audio_duration_sec": 1.876, "asr_duration": 0.5280053615570068, "asr_confidence": 0.8834254975110766, "asr_text": "um Verletzungen vorzubeugen.", "asr_word_count": 3, "llm_duration": 1.9240474700927734, "llm_text": "to prevent injuries.", "llm_word_count": 3, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.6209485530853271, "tts_audio_size_bytes": 93260, "e2e_duration": 3.3228931427001953, "rtf": 1.771, "timestamp": "2026-02-13T11:22:22.123523"}
{"correlation_id": "221edf81-b344-4c1a-ace2-5f3c2efb03e0", "start_time": 1770981742.4547882, "audio_duration_sec": 1.556, "asr_duration": 0.45205163955688477, "asr_confidence": 0.752876431180285, "asr_text": "in ihrem Essverhalten.", "asr_word_count": 3, "llm_duration": 1.8035030364990234, "llm_text": "in their eating habits.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.5463931560516357, "tts_audio_size_bytes": 79948, "e2e_duration": 2.802706718444824, "rtf": 1.801, "timestamp": "2026-02-13T11:22:25.257505"}
{"correlation_id": "404e818c-fed8-4610-9d1a-cfeeb359b67a", "start_time": 1770981747.9630206, "audio_duration_sec": 4.244, "asr_duration": 0.7667422294616699, "asr_confidence": 0.8625350749578288, "asr_text": "Ich kann euch sagen, aus meiner kurzen Erfahrung des Kalorienzellens,", "asr_word_count": 10, "llm_duration": 3.250145435333252, "llm_text": "I can tell you from my brief experience with calorie counting,", "llm_word_count": 11, "src_lang": "de", "tgt_lang": "en", "tts_duration": 2.5533254146575928, "tts_audio_size_bytes": 178252, "e2e_duration": 6.570882558822632, "rtf": 1.548, "timestamp": "2026-02-13T11:22:34.533916"}
{"correlation_id": "4cf6a3dc-9a84-4306-821d-61ba11138403", "start_time": 1770981752.1012762, "audio_duration_sec": 3.988, "asr_duration": 1.4786813259124756, "asr_confidence": 0.9807679887665856, "asr_text": "Da wird ganz genau darauf geachtet, welche Nährstoffe ich meinem Körper zufüge.", "asr_word_count": 12, "llm_duration": 3.665095329284668, "llm_text": "Great attention is given to the nutrients I provide my body.", "llm_word_count": 11, "src_lang": "de", "tgt_lang": "en", "tts_duration": 2.329364061355591, "tts_audio_size_bytes": 169036, "e2e_duration": 7.4738969802856445, "rtf": 1.874, "timestamp": "2026-02-13T11:22:39.575186"}
{"correlation_id": "01f73942-908c-4e50-bfaf-9e2f838a0294", "start_time": 1770981757.0514524, "audio_duration_sec": 4.404, "asr_duration": 1.760479211807251, "asr_confidence": 0.9614131642295473, "asr_text": "Und vor allem, welche Schadstoffe ich meinem Körper eben nicht zuführe.", "asr_word_count": 11, "llm_duration": 4.225640058517456, "llm_text": "And above all, what harmful substances I do not introduce into my body.", "llm_word_count": 13, "src_lang": "de", "tgt_lang": "en", "tts_duration": 2.8124752044677734, "tts_audio_size_bytes": 280652, "e2e_duration": 8.799388647079468, "rtf": 1.998, "timestamp": "2026-02-13T11:22:45.850855"}
{"correlation_id": "86a9d3da-db1e-4db5-9874-24feabf38647", "start_time": 1770981761.4839356, "audio_duration_sec": 2.132, "asr_duration": 0.7324728965759277, "asr_confidence": 0.9453335541364521, "asr_text": "Und zu guter Letzt in der Auswertung.", "asr_word_count": 7, "llm_duration": 3.00736403465271, "llm_text": "And finally, in the evaluation.", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.3811030387878418, "tts_audio_size_bytes": 175692, "e2e_duration": 5.943233251571655, "rtf": 2.788, "timestamp": "2026-02-13T11:22:47.427183"}
{"correlation_id": "faf881b7-a308-45f7-acac-460270d471ba", "start_time": 1770981764.374049, "audio_duration_sec": 2.1, "asr_duration": 0.8348791599273682, "asr_confidence": 0.8821835739278971, "asr_text": "Das passiert oft gemeinsam mit einem Coach.", "asr_word_count": 7, "llm_duration": 3.0670878887176514, "llm_text": "This often occurs in conjunction with a coach.", "llm_word_count": 8, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.3019917011260986, "tts_audio_size_bytes": 140364, "e2e_duration": 6.041461944580078, "rtf": 2.877, "timestamp": "2026-02-13T11:22:50.415524"}
{"correlation_id": "d9dd0806-34cd-4ea9-b118-90f0c034f055", "start_time": 1770981770.3917797, "audio_duration_sec": 0.884, "asr_duration": 0.4435086250305176, "asr_confidence": 0.5756553855550588, "asr_text": "Im Mütz.", "asr_word_count": 2, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "84b41785-3e20-4aed-b8fb-598f81860243", "start_time": 1770981768.8207428, "audio_duration_sec": 3.252, "asr_duration": 0.6278884410858154, "asr_confidence": 0.8486889795327136, "asr_text": "oder mit einer zweiten Person oder mit einem Trainingspartner.", "asr_word_count": 9, "llm_duration": 3.3977625370025635, "llm_text": "or with a second person or with a training partner.", "llm_word_count": 10, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.958890676498413, "tts_audio_size_bytes": 178252, "e2e_duration": 5.985238790512085, "rtf": 1.84, "timestamp": "2026-02-13T11:22:54.805998"}
{"correlation_id": "2b154c75-64d9-4f21-9085-3e8d6a5496db", "start_time": 1770981773.2861953, "audio_duration_sec": 2.548, "asr_duration": 0.6061661243438721, "asr_confidence": 0.8792710073308405, "asr_text": "darüber schauen, wie es denn aktuell läuft.", "asr_word_count": 7, "llm_duration": 2.83117938041687, "llm_text": "thereby examining how it currently stands.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.0543298721313477, "tts_audio_size_bytes": 137804, "e2e_duration": 4.4923481941223145, "rtf": 1.763, "timestamp": "2026-02-13T11:22:57.778554"}
{"correlation_id": "ec9d0d34-c145-4fbf-bbbe-38d9e4cb8352", "start_time": 1770981775.9057713, "audio_duration_sec": 1.908, "asr_duration": 0.48113059997558594, "asr_confidence": 0.8775859698141119, "asr_text": "Und diese Struktur", "asr_word_count": 3, "llm_duration": 1.6735384464263916, "llm_text": "And this structure", "llm_word_count": 3, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.1191585063934326, "tts_audio_size_bytes": 73292, "e2e_duration": 3.61149001121521, "rtf": 1.893, "timestamp": "2026-02-13T11:22:59.517270"}
{"correlation_id": "d9f79964-d47b-4b4d-8eaf-25d2b4ba56e8", "start_time": 1770981779.8305209, "audio_duration_sec": 1.428, "asr_duration": 0.4006941318511963, "asr_confidence": 0.6892096222742091, "asr_text": "Jahr für Jahr.", "asr_word_count": 3, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "1db5bf37-79a7-4672-8da7-10b3f6a19406", "start_time": 1770981778.5198596, "audio_duration_sec": 2.196, "asr_duration": 0.7781956195831299, "asr_confidence": 0.8423585846498927, "asr_text": "Gilt es Tag ein, Tag aus?", "asr_word_count": 6, "llm_duration": 2.414889335632324, "llm_text": "Is it day by day?", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.7981288433074951, "tts_audio_size_bytes": 86604, "e2e_duration": 3.992150068283081, "rtf": 1.818, "timestamp": "2026-02-13T11:23:02.512020"}
{"correlation_id": "16b6be76-3fe7-4ba0-ad60-76ef8e4c7fea", "start_time": 1770981780.352067, "audio_duration_sec": 0.404, "asr_duration": 0.40511369705200195, "asr_confidence": 0.817638778937947, "asr_text": "Vielen Dank.", "asr_word_count": 2, "llm_duration": 1.4360620975494385, "llm_text": "Thanks.", "llm_word_count": 1, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.9920191764831543, "tts_audio_size_bytes": 131148, "e2e_duration": 3.7902441024780273, "rtf": 9.382, "timestamp": "2026-02-13T11:23:04.142326"}
{"correlation_id": "c1c7d2ea-29d6-466d-bd79-f7081ba4c5c8", "start_time": 1770981781.406165, "audio_duration_sec": 1.076, "asr_duration": 0.4711282253265381, "asr_confidence": 0.7874041111418167, "asr_text": "zu wiederholen.", "asr_word_count": 2, "llm_duration": 1.6925544738769531, "llm_text": "to repeat.", "llm_word_count": 2, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.42882680892944336, "tts_audio_size_bytes": 62028, "e2e_duration": 3.865849494934082, "rtf": 3.593, "timestamp": "2026-02-13T11:23:05.272024"}
{"correlation_id": "b65d7806-2624-42c8-b6dc-97a41053963a", "start_time": 1770981785.3527966, "audio_duration_sec": 1.14, "asr_duration": 0.4339134693145752, "asr_confidence": 0.8921913004292616, "asr_text": "Und wofür?", "asr_word_count": 2, "llm_duration": 1.7690279483795166, "llm_text": "And for what?", "llm_word_count": 3, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.49686312675476074, "tts_audio_size_bytes": 62028, "e2e_duration": 2.7004427909851074, "rtf": 2.369, "timestamp": "2026-02-13T11:23:08.053248"}
{"correlation_id": "b5168cad-7142-4f86-b816-cbbab71420b1", "start_time": 1770981785.878347, "audio_duration_sec": 0.436, "asr_duration": 0.40085577964782715, "asr_confidence": 0.7539800856583552, "asr_text": "Vielen Dank.", "asr_word_count": 2, "llm_duration": 1.3548362255096436, "llm_text": "Thanks.", "llm_word_count": 1, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.0482416152954102, "tts_audio_size_bytes": 135756, "e2e_duration": 4.081445932388306, "rtf": 9.361, "timestamp": "2026-02-13T11:23:09.959803"}
{"correlation_id": "c1f55b01-efb0-44d2-be9e-710bc555cf8e", "start_time": 1770981791.3727057, "audio_duration_sec": 2.612, "asr_duration": 0.4987678527832031, "asr_confidence": 0.9400837086942309, "asr_text": "für einen vergänglichen Siegeskranz.", "asr_word_count": 4, "llm_duration": 2.5137574672698975, "llm_text": "for a perishable crown of victory.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.9819791316986084, "tts_audio_size_bytes": 131148, "e2e_duration": 3.9951400756835938, "rtf": 1.53, "timestamp": "2026-02-13T11:23:15.367857"}
{"correlation_id": "dc2437d3-730f-4495-93be-f1d9707a6a63", "start_time": 1770981792.9496903, "audio_duration_sec": 0.436, "asr_duration": 0.3914761543273926, "asr_confidence": 0.7253316307052922, "asr_text": "Vielen Dank.", "asr_word_count": 2, "llm_duration": 1.4539663791656494, "llm_text": "Thanks.", "llm_word_count": 1, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.7301163673400879, "tts_audio_size_bytes": 106572, "e2e_duration": 3.6206018924713135, "rtf": 8.304, "timestamp": "2026-02-13T11:23:16.570301"}
{"correlation_id": "b20a8278-9346-4bc8-958b-4d6f9b1d3c9b", "start_time": 1770981796.6098092, "audio_duration_sec": 2.388, "asr_duration": 0.4888179302215576, "asr_confidence": 0.9249877732960601, "asr_text": "der nach wenigen Tagen verwelkt ist.", "asr_word_count": 6, "llm_duration": 2.5442044734954834, "llm_text": "which withers away in a few days.", "llm_word_count": 7, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.515120029449463, "tts_audio_size_bytes": 109132, "e2e_duration": 4.548784494400024, "rtf": 1.905, "timestamp": "2026-02-13T11:23:21.158603"}
{"correlation_id": "93d2f770-6b94-4b6e-ba8e-21c817515c8c", "start_time": 1770981799.7621763, "audio_duration_sec": 2.452, "asr_duration": 0.9007229804992676, "asr_confidence": 0.926333789751822, "asr_text": "Und ja, auch für Ansehen und Ehre.", "asr_word_count": 7, "llm_duration": 2.527815103530884, "llm_text": "And indeed, for honor and glory.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.116999626159668, "tts_audio_size_bytes": 133708, "e2e_duration": 4.546246528625488, "rtf": 1.854, "timestamp": "2026-02-13T11:23:24.308432"}
{"correlation_id": "17c1b80f-e2a0-4ad2-b545-c62b8db46a6c", "start_time": 1770981807.3520162, "audio_duration_sec": 6.132, "asr_duration": 0.9619061946868896, "asr_confidence": 0.9535339070066604, "asr_text": "Aber ich habe mir mal die Frage gestellt, wer hat denn bei den vorletzten Olympischen Spielen im 100-Meter-Sprint gewonnen?", "asr_word_count": 19, "llm_duration": 4.944380044937134, "llm_text": "But I have wondered who won the 100-meter sprint at the penultimate Olympic Games?", "llm_word_count": 14, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.8861911296844482, "tts_audio_size_bytes": 242764, "e2e_duration": 7.793076038360596, "rtf": 1.271, "timestamp": "2026-02-13T11:23:35.145106"}
{"correlation_id": "b5bf4cd9-4845-44d8-a2ff-ce5287276915", "start_time": 1770981812.5835328, "audio_duration_sec": 1.62, "asr_duration": 0.6158969402313232, "asr_confidence": 0.848462966890375, "asr_text": "Meine Antwort war auch dünn.", "asr_word_count": 5, "llm_duration": 2.471036434173584, "llm_text": "My answer was also thin.", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.6196746826171875, "tts_audio_size_bytes": 95820, "e2e_duration": 3.766406297683716, "rtf": 2.325, "timestamp": "2026-02-13T11:23:36.349952"}
{"correlation_id": "5a32f426-c13d-4b9d-b2ef-4c2e77417d6f", "start_time": 1770981839.073162, "audio_duration_sec": 0.5, "asr_duration": 0.6876142024993896, "asr_confidence": 0.5087587873875726, "asr_text": "Vielen Dank.", "asr_word_count": 2, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "277485ab-b521-4f29-a9cd-a68529c319cf", "start_time": 1770981826.5074654, "audio_duration_sec": 11.284, "asr_duration": 1.412118911743164, "asr_confidence": 0.939298392413804, "asr_text": "Das ist, glaube ich, das, was Paulus hier beschreibt mit, ich laufe nun nicht so wie ins Ungewisse, ich kämpfe so nicht wie einer, der in die Luft schlägt, sondern ich zerschlage meinen Leib und knechte ihn.", "asr_word_count": 37, "llm_duration": 8.586607456207275, "llm_text": "I think this is what Paul describes here: I do not run aimlessly, nor do I box as one who beats the air; but I discipline my body and bring it into submission.", "llm_word_count": 33, "src_lang": "de", "tgt_lang": "en", "tts_duration": 6.854548931121826, "tts_audio_size_bytes": 588364, "e2e_duration": 16.853960037231445, "rtf": 1.494, "timestamp": "2026-02-13T11:24:03.361445"}
{"correlation_id": "b97d4289-e0bf-4017-ba14-855293fbe9a3", "start_time": 1770981830.961165, "audio_duration_sec": 2.42, "asr_duration": 0.4885213375091553, "asr_confidence": 0.8448550595940676, "asr_text": "den eigenen Körper zu knechten,", "asr_word_count": 5, "llm_duration": 2.928832769393921, "llm_text": "to chasten one's own body", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.8017253875732422, "tts_audio_size_bytes": 99916, "e2e_duration": 13.250218391418457, "rtf": 5.475, "timestamp": "2026-02-13T11:24:04.211390"}
{"correlation_id": "f83cd625-1a77-426c-8c05-0280ce7b2cdd", "start_time": 1770981837.2373257, "audio_duration_sec": 4.148, "asr_duration": 1.1139731407165527, "asr_confidence": 0.8275125071359387, "asr_text": "und dem großen, übergeordneten Ziel unterzuordnen.", "asr_word_count": 6, "llm_duration": 3.9738142490386963, "llm_text": "and to subordinate it to the great, overarching goal.", "llm_word_count": 9, "src_lang": "de", "tgt_lang": "en", "tts_duration": 2.317429304122925, "tts_audio_size_bytes": 195660, "e2e_duration": 9.293280839920044, "rtf": 2.24, "timestamp": "2026-02-13T11:24:06.530618"}
{"correlation_id": "4d0abe0b-1dfa-48a5-b38b-6fbcc471d7c5", "start_time": 1770981842.2313714, "audio_duration_sec": 3.092, "asr_duration": 1.1781432628631592, "asr_confidence": 0.9459008181554065, "asr_text": "Jetzt war Paulus aber, soweit ich weiß, kein Profisportler.", "asr_word_count": 9, "llm_duration": 4.627219200134277, "llm_text": "Now Paul, so far as I know, was not a professional athlete.", "llm_word_count": 12, "src_lang": "de", "tgt_lang": "en", "tts_duration": 2.7048540115356445, "tts_audio_size_bytes": 251468, "e2e_duration": 8.511517524719238, "rtf": 2.753, "timestamp": "2026-02-13T11:24:10.742899"}
{"correlation_id": "507ee254-4530-43f3-bdbe-e0ca900a7155", "start_time": 1770981845.391402, "audio_duration_sec": 1.748, "asr_duration": 0.8537387847900391, "asr_confidence": 0.8379008736389281, "asr_text": "sondern Nachfolger Jesu.", "asr_word_count": 3, "llm_duration": 2.5057742595672607, "llm_text": "but successors of Jesus.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.1867191791534424, "tts_audio_size_bytes": 155724, "e2e_duration": 6.543961048126221, "rtf": 3.744, "timestamp": "2026-02-13T11:24:11.935373"}
{"correlation_id": "37f286f1-1d1e-4b18-8b77-6243215b4c20", "start_time": 1770981849.8596244, "audio_duration_sec": 2.932, "asr_duration": 0.9041998386383057, "asr_confidence": 0.9061933345331717, "asr_text": "Und was können wir, auch Nachfolger Jesu,", "asr_word_count": 7, "llm_duration": 2.7944648265838623, "llm_text": "And what can we, His successors,", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.9303076267242432, "tts_audio_size_bytes": 117836, "e2e_duration": 4.629814624786377, "rtf": 1.579, "timestamp": "2026-02-13T11:24:14.489449"}
{"correlation_id": "edd5c393-789e-4692-b07d-8f9947e3fb62", "start_time": 1770981852.2219858, "audio_duration_sec": 1.812, "asr_duration": 0.4273042678833008, "asr_confidence": 0.8019547252627087, "asr_text": "jetzt von diesem Bild lernen.", "asr_word_count": 5, "llm_duration": 2.5386223793029785, "llm_text": "now learn from this parable.", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.2884180545806885, "tts_audio_size_bytes": 93260, "e2e_duration": 5.164635419845581, "rtf": 2.85, "timestamp": "2026-02-13T11:24:17.386644"}
{"correlation_id": "d4f1c6d7-34b9-46e2-9b2f-1059d5ae2858", "start_time": 1770981855.1024194, "audio_duration_sec": 1.3, "asr_duration": 0.40149521827697754, "asr_confidence": 0.736120384933654, "asr_text": "Strukturen.", "asr_word_count": 1, "llm_duration": 1.8329887390136719, "llm_text": "Structures.", "llm_word_count": 1, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.0556259155273438, "tts_audio_size_bytes": 66636, "e2e_duration": 3.884753942489624, "rtf": 2.988, "timestamp": "2026-02-13T11:24:18.987183"}
{"correlation_id": "922f7e43-b8ca-4351-adc1-e8a85b4087f4", "start_time": 1770981856.6737015, "audio_duration_sec": 1.332, "asr_duration": 0.7501194477081299, "asr_confidence": 0.7415420249200907, "asr_text": "Ich blase nochmal einmal zurück.", "asr_word_count": 5, "llm_duration": 2.5198426246643066, "llm_text": "I blow again into his mouth.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.688133716583252, "tts_audio_size_bytes": 93260, "e2e_duration": 4.466169357299805, "rtf": 3.353, "timestamp": "2026-02-13T11:24:21.139880"}
{"correlation_id": "8febd847-4500-40f1-b2cf-b3f3f43e70de", "start_time": 1770981858.2377589, "audio_duration_sec": 1.204, "asr_duration": 0.6479213237762451, "asr_confidence": 0.7755481112039304, "asr_text": "Strukturen.", "asr_word_count": 1, "llm_duration": 1.7114980220794678, "llm_text": "Structures.", "llm_word_count": 1, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.4366130828857422, "tts_audio_size_bytes": 57932, "e2e_duration": 4.362570762634277, "rtf": 3.623, "timestamp": "2026-02-13T11:24:22.600338"}
{"correlation_id": "061ea939-c454-4ff4-9a71-bbfa55b99c88", "start_time": 1770981861.3735633, "audio_duration_sec": 2.484, "asr_duration": 0.44239377975463867, "asr_confidence": 0.8607453343528032, "asr_text": "helfen und sind notwendig.", "asr_word_count": 4, "llm_duration": 1.9677002429962158, "llm_text": "help and are necessary.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.9145686626434326, "tts_audio_size_bytes": 137804, "e2e_duration": 3.6727795600891113, "rtf": 1.479, "timestamp": "2026-02-13T11:24:25.046356"}
{"correlation_id": "60ea5dfd-3447-43d4-b153-4849230c4836", "start_time": 1770981865.812245, "audio_duration_sec": 2.068, "asr_duration": 0.4326660633087158, "asr_confidence": 0.8161762130223398, "asr_text": "auch im Tagesablauf.", "asr_word_count": 3, "llm_duration": 1.892340898513794, "llm_text": "in the daily routine.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.3299033641815186, "tts_audio_size_bytes": 75340, "e2e_duration": 3.655553102493286, "rtf": 1.768, "timestamp": "2026-02-13T11:24:29.467811"}
{"correlation_id": "13a0da16-66f0-46cc-b2e9-e586ef7b9519", "start_time": 1770981872.3152912, "audio_duration_sec": 0.5, "asr_duration": 0.6707360744476318, "asr_confidence": 0.4680806946794152, "asr_text": "Vielen Dank.", "asr_word_count": 2, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "dd51ee17-ec98-4eab-881e-99e1e32cbcf3", "start_time": 1770981868.393995, "audio_duration_sec": 2.132, "asr_duration": 0.9290947914123535, "asr_confidence": 0.8414118656275413, "asr_text": "Zum Beispiel mit dem Bibellesen.", "asr_word_count": 5, "llm_duration": 2.57714581489563, "llm_text": "For example, with the Bible reading.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.4562487602233887, "tts_audio_size_bytes": 119884, "e2e_duration": 4.963190317153931, "rtf": 2.328, "timestamp": "2026-02-13T11:24:33.357200"}
{"correlation_id": "d63bc471-e3c1-4a55-88b7-6cbaf21bd72e", "start_time": 1770981870.7527223, "audio_duration_sec": 1.684, "asr_duration": 0.43871402740478516, "asr_confidence": 0.8819799686452922, "asr_text": "mit unseren Gebetszeiten.", "asr_word_count": 3, "llm_duration": 2.244799852371216, "llm_text": "with our prayer times.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.5152609348297119, "tts_audio_size_bytes": 79948, "e2e_duration": 3.9086177349090576, "rtf": 2.321, "timestamp": "2026-02-13T11:24:34.661349"}
{"correlation_id": "53283e58-5bd2-4451-a1b9-a96bc98a199e", "start_time": 1770981879.64976, "audio_duration_sec": 0.468, "asr_duration": 0.3908250331878662, "asr_confidence": 0.5578898430379505, "asr_text": "Amen.", "asr_word_count": 1, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "9f0c1f4d-2000-44e1-b6ec-d823437b1d83", "start_time": 1770981879.133473, "audio_duration_sec": 6.484, "asr_duration": 0.9019246101379395, "asr_confidence": 0.9390580095130681, "asr_text": "in unserem Alltag Hilfsbereitschaft und Großzügigkeit, den Menschen in unserem Umfeld zu lernen, zu wirken.", "asr_word_count": 15, "llm_duration": 5.231542348861694, "llm_text": "in our everyday life readiness to help and generosity, to learn and work with the people in our surroundings.", "llm_word_count": 19, "src_lang": "de", "tgt_lang": "en", "tts_duration": 4.093296051025391, "tts_audio_size_bytes": 405580, "e2e_duration": 10.227463245391846, "rtf": 1.577, "timestamp": "2026-02-13T11:24:49.360948"}
{"correlation_id": "24aff441-dd2e-4d69-adb0-2841993a6de2", "start_time": 1770981882.7818637, "audio_duration_sec": 1.492, "asr_duration": 0.6901936531066895, "asr_confidence": 0.7815096526340314, "asr_text": "In der Regeneration.", "asr_word_count": 3, "llm_duration": 1.8358585834503174, "llm_text": "In regeneration.", "llm_word_count": 2, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.9843659400939941, "tts_audio_size_bytes": 71244, "e2e_duration": 7.572224140167236, "rtf": 5.075, "timestamp": "2026-02-13T11:24:50.354107"}
{"correlation_id": "f11d7642-c081-4be3-aad7-d63722940ae2", "start_time": 1770981893.0166574, "audio_duration_sec": 0.468, "asr_duration": 0.6253321170806885, "asr_confidence": 0.6263954315183771, "asr_text": "Vielen Dank.", "asr_word_count": 2, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "a26ba59f-12d2-4a81-ada3-83561c5bb3d9", "start_time": 1770981887.4981728, "audio_duration_sec": 4.084, "asr_duration": 1.2412850856781006, "asr_confidence": 0.977247041311286, "asr_text": "Vielleicht erinnert sich noch jemand an die letzte Predigt von mir über den Sabbat.", "asr_word_count": 14, "llm_duration": 3.3816404342651367, "llm_text": "Perhaps someone remembers my last sermon on the Sabbath.", "llm_word_count": 9, "src_lang": "de", "tgt_lang": "en", "tts_duration": 2.03975248336792, "tts_audio_size_bytes": 149068, "e2e_duration": 6.6633546352386475, "rtf": 1.632, "timestamp": "2026-02-13T11:24:54.161540"}
{"correlation_id": "23dde30f-35a6-4c71-9a16-15c325bac1ef", "start_time": 1770981889.8647213, "audio_duration_sec": 2.036, "asr_duration": 0.6499674320220947, "asr_confidence": 0.8910233766955563, "asr_text": "über einen Ruhetag in der Woche.", "asr_word_count": 6, "llm_duration": 3.3343117237091064, "llm_text": "on a sabbath day in the week.", "llm_word_count": 7, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.6799020767211914, "tts_audio_size_bytes": 93260, "e2e_duration": 6.271605968475342, "rtf": 3.08, "timestamp": "2026-02-13T11:24:56.136338"}
{"correlation_id": "8506d66d-aff6-4da8-a7b5-09308b0c5298", "start_time": 1770981891.9702475, "audio_duration_sec": 1.972, "asr_duration": 0.7325925827026367, "asr_confidence": 0.743664878203907, "asr_text": "oder Regelmäßigkeit hineinbringen.", "asr_word_count": 3, "llm_duration": 2.5006065368652344, "llm_text": "or regularity to bring in.", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.2115263938903809, "tts_audio_size_bytes": 149068, "e2e_duration": 7.1986448764801025, "rtf": 3.65, "timestamp": "2026-02-13T11:24:59.168913"}
{"correlation_id": "4ee133e3-4628-4fa9-8630-87d44f2ac25b", "start_time": 1770981896.1659222, "audio_duration_sec": 1.46, "asr_duration": 0.43236565589904785, "asr_confidence": 0.8270524592501709, "asr_text": "Auch im Essverhalten.", "asr_word_count": 3, "llm_duration": 2.119298219680786, "llm_text": "Even in eating habits.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.6942758560180664, "tts_audio_size_bytes": 86604, "e2e_duration": 4.605364084243774, "rtf": 3.154, "timestamp": "2026-02-13T11:25:00.771296"}
{"correlation_id": "f208cb30-bb72-4f6b-a3c3-7f545e52aed3", "start_time": 1770981902.9708214, "audio_duration_sec": 5.876, "asr_duration": 0.8249261379241943, "asr_confidence": 0.9154586546535619, "asr_text": "durch beispielsweise einen Fastentag pro Woche oder einen Fastentag pro Monat.", "asr_word_count": 11, "llm_duration": 4.6798787117004395, "llm_text": "through, for example, a day of fasting each week or a day of fasting each month.", "llm_word_count": 16, "src_lang": "de", "tgt_lang": "en", "tts_duration": 3.2968711853027344, "tts_audio_size_bytes": 313932, "e2e_duration": 8.80228304862976, "rtf": 1.498, "timestamp": "2026-02-13T11:25:11.773124"}
{"correlation_id": "2657a0f0-f1e7-4510-a0b6-fbaec9c59233", "start_time": 1770981905.064593, "audio_duration_sec": 2.196, "asr_duration": 0.4372849464416504, "asr_confidence": 0.7885968862806729, "asr_text": "Oder die Fastenzeit nutzen.", "asr_word_count": 4, "llm_duration": 2.945936679840088, "llm_text": "Or use the time of fasting.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.998706579208374, "tts_audio_size_bytes": 153676, "e2e_duration": 8.714691162109375, "rtf": 3.968, "timestamp": "2026-02-13T11:25:13.779299"}
{"correlation_id": "e08854f1-55dc-45a6-bff0-b7989629005a", "start_time": 1770981914.2410927, "audio_duration_sec": 1.108, "asr_duration": 0.6778695583343506, "asr_confidence": 0.6813701632844384, "asr_text": "meint hatte.", "asr_word_count": 2, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "3f108980-4880-48a5-b507-ae632128cce6", "start_time": 1770981909.2537167, "audio_duration_sec": 1.652, "asr_duration": 0.8724880218505859, "asr_confidence": 0.9509507855321203, "asr_text": "Und auch in Gemeinschaft.", "asr_word_count": 4, "llm_duration": 2.4544122219085693, "llm_text": "And also in community.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.235776662826538, "tts_audio_size_bytes": 88652, "e2e_duration": 5.859400510787964, "rtf": 3.547, "timestamp": "2026-02-13T11:25:15.113137"}
{"correlation_id": "89604d65-1f0d-45cd-9f28-98c457c72420", "start_time": 1770981912.6666434, "audio_duration_sec": 3.188, "asr_duration": 1.015840768814087, "asr_confidence": 0.8334724738379913, "asr_text": "Manchmal in dem gleichen Setting, wie ich das vorhin mit dem Coach...", "asr_word_count": 12, "llm_duration": 3.8953778743743896, "llm_text": "Sometimes in the same setting as I just had with the coach...", "llm_word_count": 12, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.2941515445709229, "tts_audio_size_bytes": 157772, "e2e_duration": 6.400562047958374, "rtf": 2.008, "timestamp": "2026-02-13T11:25:19.067226"}
{"correlation_id": "100fa0b3-1165-4eb1-ad90-8443242b4f3c", "start_time": 1770981915.5452254, "audio_duration_sec": 1.236, "asr_duration": 0.4223666191101074, "asr_confidence": 0.7120553739453455, "asr_text": "In Mentorings?", "asr_word_count": 2, "llm_duration": 2.1207950115203857, "llm_text": "In Mentoring?", "llm_word_count": 2, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.4874439239501953, "tts_audio_size_bytes": 64588, "e2e_duration": 4.836404085159302, "rtf": 3.913, "timestamp": "2026-02-13T11:25:20.381644"}
{"correlation_id": "e97aac41-5847-485f-8744-a35f81167a0c", "start_time": 1770981919.1965532, "audio_duration_sec": 3.188, "asr_duration": 0.5515339374542236, "asr_confidence": 0.8875866507015359, "asr_text": "Aber auch das, was wir heute hier machen, im Gottesdienst.", "asr_word_count": 10, "llm_duration": 3.4244964122772217, "llm_text": "But also what we do here today in the worship service.", "llm_word_count": 11, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.1311697959899902, "tts_audio_size_bytes": 147020, "e2e_duration": 5.253634691238403, "rtf": 1.648, "timestamp": "2026-02-13T11:25:24.450197"}
{"correlation_id": "5dcdafef-4e41-4b9f-b13a-41c5ad50370a", "start_time": 1770981921.8232214, "audio_duration_sec": 2.164, "asr_duration": 0.484438419342041, "asr_confidence": 0.8771434419643392, "asr_text": "oder unter der Woche in Kleingruppen.", "asr_word_count": 6, "llm_duration": 2.6839687824249268, "llm_text": "or during the week in small groups.", "llm_word_count": 7, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.9254453182220459, "tts_audio_size_bytes": 140364, "e2e_duration": 5.10554575920105, "rtf": 2.359, "timestamp": "2026-02-13T11:25:26.928777"}
{"correlation_id": "691ca59e-5ba4-4d03-bf7f-2b63da79475f", "start_time": 1770981930.1781886, "audio_duration_sec": 1.236, "asr_duration": 0.39234113693237305, "asr_confidence": 0.6164833412706966, "asr_text": "unterstützt.", "asr_word_count": 1, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "d0108518-ef14-40d9-927c-1b6a5cc4e734", "start_time": 1770981928.3545284, "audio_duration_sec": 4.82, "asr_duration": 0.6439690589904785, "asr_confidence": 0.9564781989057908, "asr_text": "wo man sich über die Nachfolge austauscht und sich gegenseitig motiviert.", "asr_word_count": 11, "llm_duration": 3.8430771827697754, "llm_text": "where one exhanges words about the succession and mutually encourages one another.", "llm_word_count": 12, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.9272851943969727, "tts_audio_size_bytes": 236108, "e2e_duration": 6.4149603843688965, "rtf": 1.331, "timestamp": "2026-02-13T11:25:34.769504"}
{"correlation_id": "4839d237-787a-4442-a806-0075493bd40a", "start_time": 1770981931.746696, "audio_duration_sec": 1.396, "asr_duration": 0.4138154983520508, "asr_confidence": 0.8766987932343244, "asr_text": "in Rat und Tat.", "asr_word_count": 4, "llm_duration": 2.282647132873535, "llm_text": "in Word and deed.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.5068726539611816, "tts_audio_size_bytes": 81996, "e2e_duration": 3.8853626251220703, "rtf": 2.783, "timestamp": "2026-02-13T11:25:35.632070"}
{"correlation_id": "68efb3e1-3401-4d32-9fd4-315594a59e29", "start_time": 1770981936.991651, "audio_duration_sec": 1.78, "asr_duration": 0.53802490234375, "asr_confidence": 0.8856048855385644, "asr_text": "Das sind alles Übungen.", "asr_word_count": 4, "llm_duration": 2.0026307106018066, "llm_text": "These are all vain exercises.", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.7679033279418945, "tts_audio_size_bytes": 126540, "e2e_duration": 4.309160232543945, "rtf": 2.421, "timestamp": "2026-02-13T11:25:41.300821"}
{"correlation_id": "0a1e0c12-7500-44b8-8ed6-e762787cce64", "start_time": 1770981940.1500888, "audio_duration_sec": 2.484, "asr_duration": 0.8988962173461914, "asr_confidence": 0.981118776904727, "asr_text": "die Jesus selbst uns vorgelebt hat.", "asr_word_count": 6, "llm_duration": 2.4512791633605957, "llm_text": "who has Himself made us an example.", "llm_word_count": 7, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.9179625511169434, "tts_audio_size_bytes": 115788, "e2e_duration": 4.268966197967529, "rtf": 1.719, "timestamp": "2026-02-13T11:25:44.419064"}
{"correlation_id": "0fe3ddf2-bcd3-47e2-8b26-d6e6ed5b389e", "start_time": 1770981944.875, "audio_duration_sec": 3.092, "asr_duration": 0.5711328983306885, "asr_confidence": 0.9521123216291425, "asr_text": "und in die er uns in der Nachfolge hineinruft.", "asr_word_count": 9, "llm_duration": 2.418977975845337, "llm_text": "and into his fellowship he calls us.", "llm_word_count": 7, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.0914158821105957, "tts_audio_size_bytes": 131148, "e2e_duration": 4.082122802734375, "rtf": 1.32, "timestamp": "2026-02-13T11:25:48.957135"}
{"correlation_id": "5276b651-51f9-4cec-b8c8-597d330509b3", "start_time": 1770981949.3295884, "audio_duration_sec": 2.42, "asr_duration": 0.4488356113433838, "asr_confidence": 0.794316376921563, "asr_text": "Wir wollen unser ganzes Leben...", "asr_word_count": 5, "llm_duration": 2.0625483989715576, "llm_text": "We want our entire lives...", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.0592405796051025, "tts_audio_size_bytes": 137804, "e2e_duration": 3.571349859237671, "rtf": 1.476, "timestamp": "2026-02-13T11:25:52.900949"}
{"correlation_id": "81433bad-936c-46ad-a196-4f13cd57b048", "start_time": 1770981951.1591082, "audio_duration_sec": 1.652, "asr_duration": 0.43323373794555664, "asr_confidence": 0.8803927601061956, "asr_text": "unter Gottes Willen stellen.", "asr_word_count": 4, "llm_duration": 2.256354808807373, "llm_text": "according to God's will place", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.411426067352295, "tts_audio_size_bytes": 126540, "e2e_duration": 4.350717782974243, "rtf": 2.634, "timestamp": "2026-02-13T11:25:55.509836"}
{"correlation_id": "ec62f68f-b59b-4a8e-9d2b-f67a7e761d64", "start_time": 1770981954.5797856, "audio_duration_sec": 1.236, "asr_duration": 0.6230309009552002, "asr_confidence": 0.9207934551491501, "asr_text": "Und wofür?", "asr_word_count": 2, "llm_duration": 1.6896889209747314, "llm_text": "And for what?", "llm_word_count": 3, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.41818976402282715, "tts_audio_size_bytes": 62028, "e2e_duration": 2.73156476020813, "rtf": 2.21, "timestamp": "2026-02-13T11:25:57.311359"}
{"correlation_id": "468072be-e648-4866-94f7-d3ced47fec2e", "start_time": 1770981959.0323946, "audio_duration_sec": 2.228, "asr_duration": 0.6056537628173828, "asr_confidence": 0.9069015719932891, "asr_text": "Für den unvergänglichen Siegeskranz.", "asr_word_count": 4, "llm_duration": 2.54695725440979, "llm_text": "For the imperishable crown of victory.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.0858888626098633, "tts_audio_size_bytes": 129100, "e2e_duration": 4.239193439483643, "rtf": 1.903, "timestamp": "2026-02-13T11:26:03.271598"}
{"correlation_id": "13aeb15c-f444-4d00-a784-c993f451fff8", "start_time": 1770981965.0556493, "audio_duration_sec": 4.084, "asr_duration": 0.732886552810669, "asr_confidence": 0.951492657980773, "asr_text": "der in Ewigkeit bestehen bleibt und mit Sicherheit nicht verwelkt.", "asr_word_count": 10, "llm_duration": 3.3578741550445557, "llm_text": "who endureth for ever and doth not pass away.", "llm_word_count": 9, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.1383893489837646, "tts_audio_size_bytes": 153676, "e2e_duration": 5.229828119277954, "rtf": 1.281, "timestamp": "2026-02-13T11:26:10.285487"}
{"correlation_id": "983092ed-c9f0-42b4-8958-70fecc72ba16", "start_time": 1770981968.1797752, "audio_duration_sec": 2.004, "asr_duration": 0.6918814182281494, "asr_confidence": 0.8592802508687483, "asr_text": "Und dafür schreibt Paulus,", "asr_word_count": 4, "llm_duration": 2.4034597873687744, "llm_text": "And for this Paul writes,", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.192880630493164, "tts_audio_size_bytes": 93260, "e2e_duration": 4.563990354537964, "rtf": 2.277, "timestamp": "2026-02-13T11:26:12.743780"}
{"correlation_id": "3405e7e7-5699-4e76-91c5-2694019d4af0", "start_time": 1770981971.3335264, "audio_duration_sec": 2.804, "asr_duration": 1.0134398937225342, "asr_confidence": 0.9558525115903103, "asr_text": "Ich zerschlage meinen Leib und knechte ihn.", "asr_word_count": 7, "llm_duration": 2.9984889030456543, "llm_text": "I will break my body and chasten it.", "llm_word_count": 8, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.1686627864837646, "tts_audio_size_bytes": 151116, "e2e_duration": 5.181333541870117, "rtf": 1.848, "timestamp": "2026-02-13T11:26:16.514880"}
{"correlation_id": "e0b8a25c-7bf8-4d26-8e5c-39e11b364fa8", "start_time": 1770981974.7444403, "audio_duration_sec": 1.684, "asr_duration": 0.7090873718261719, "asr_confidence": 0.7698945388007176, "asr_text": "Oder in anderen Worten.", "asr_word_count": 4, "llm_duration": 2.1219005584716797, "llm_text": "Or in other words.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.49440908432006836, "tts_audio_size_bytes": 71244, "e2e_duration": 3.326117992401123, "rtf": 1.975, "timestamp": "2026-02-13T11:26:18.070568"}
{"correlation_id": "2155a96d-32ce-4c7b-8636-0551ce818e9f", "start_time": 1770981978.6754987, "audio_duration_sec": 3.7, "asr_duration": 0.5256803035736084, "asr_confidence": 0.8829566578593885, "asr_text": "Spricht Jesus selbst in Matthäus 10, Vers 38.", "asr_word_count": 8, "llm_duration": 3.705218553543091, "llm_text": "Jesus himself speaks in Matthew 10, Verse 38.", "llm_word_count": 8, "src_lang": "de", "tgt_lang": "en", "tts_duration": 2.564051389694214, "tts_audio_size_bytes": 226892, "e2e_duration": 6.795592784881592, "rtf": 1.837, "timestamp": "2026-02-13T11:26:25.471116"}
{"correlation_id": "6a7256f8-a092-400e-9041-34f5b38ab7b3", "start_time": 1770981981.551879, "audio_duration_sec": 2.26, "asr_duration": 0.6876904964447021, "asr_confidence": 0.9216031030515403, "asr_text": "wenn jemand mir nachkommen will.", "asr_word_count": 5, "llm_duration": 2.861384630203247, "llm_text": "if anyone wishes to follow me.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.5771939754486084, "tts_audio_size_bytes": 93260, "e2e_duration": 5.794192552566528, "rtf": 2.564, "timestamp": "2026-02-13T11:26:27.346082"}
{"correlation_id": "d60aed12-382f-4ce7-a108-992a16074d89", "start_time": 1770981983.9186, "audio_duration_sec": 2.004, "asr_duration": 0.8735241889953613, "asr_confidence": 0.8368675254690293, "asr_text": "verleugne er sich selbst.", "asr_word_count": 4, "llm_duration": 2.377573251724243, "llm_text": "let him deny himself.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.7447900772094727, "tts_audio_size_bytes": 91212, "e2e_duration": 4.97298002243042, "rtf": 2.482, "timestamp": "2026-02-13T11:26:28.891589"}
{"correlation_id": "3be8a72b-d9a4-4203-9b6d-5f23ffa4b512", "start_time": 1770981985.7483854, "audio_duration_sec": 1.844, "asr_duration": 0.8255701065063477, "asr_confidence": 0.9179775098661018, "asr_text": "Und nehme sein Kreuz auf sich.", "asr_word_count": 6, "llm_duration": 2.3739049434661865, "llm_text": "And take his cross upon himself.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.8175148963928223, "tts_audio_size_bytes": 106572, "e2e_duration": 5.590157985687256, "rtf": 3.032, "timestamp": "2026-02-13T11:26:31.338554"}
{"correlation_id": "e81155d9-8b71-44e5-8715-e8352eacb224", "start_time": 1770981987.0639434, "audio_duration_sec": 1.364, "asr_duration": 0.48076295852661133, "asr_confidence": 0.8777220148895389, "asr_text": "Und folge mir nach.", "asr_word_count": 4, "llm_duration": 1.8163323402404785, "llm_text": "And follow me.", "llm_word_count": 3, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.4210984706878662, "tts_audio_size_bytes": 64588, "e2e_duration": 5.694858074188232, "rtf": 4.175, "timestamp": "2026-02-13T11:26:32.758812"}
{"correlation_id": "d26fb6b5-860b-4d34-b19f-ad1f043326fa", "start_time": 1770981994.3399072, "audio_duration_sec": 4.308, "asr_duration": 0.6813013553619385, "asr_confidence": 0.9410794452089231, "asr_text": "Ich glaube, wir sind uns alle einig, wenn das nicht die zwei bequemsten Bibelstellen sind.", "asr_word_count": 15, "llm_duration": 4.412011384963989, "llm_text": "I believe we are all agreed that these are not the two most comfortable Bible verses.", "llm_word_count": 16, "src_lang": "de", "tgt_lang": "en", "tts_duration": 4.089258432388306, "tts_audio_size_bytes": 298572, "e2e_duration": 9.1833336353302, "rtf": 2.132, "timestamp": "2026-02-13T11:26:43.523256"}
{"correlation_id": "c98d4f26-b9f1-4f0d-a6de-cf614eb6a07d", "start_time": 1770981995.9049525, "audio_duration_sec": 1.492, "asr_duration": 0.4295682907104492, "asr_confidence": 0.9000490748049598, "asr_text": "über die wir gerade reden.", "asr_word_count": 5, "llm_duration": 2.628845691680908, "llm_text": "of which we are speaking.", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.6227622032165527, "tts_audio_size_bytes": 79948, "e2e_duration": 8.247868061065674, "rtf": 5.528, "timestamp": "2026-02-13T11:26:44.152839"}
{"correlation_id": "ac0a75e5-dd2c-4573-a24e-7c29772ea6ec", "start_time": 1770982000.6030982, "audio_duration_sec": 2.164, "asr_duration": 1.0851893424987793, "asr_confidence": 0.8436039737094881, "asr_text": "Es geht nämlich darum, von meinem Verlangen", "asr_word_count": 7, "llm_duration": 2.356858015060425, "llm_text": "It is about my desire", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.6889216899871826, "tts_audio_size_bytes": 95820, "e2e_duration": 4.506185054779053, "rtf": 2.082, "timestamp": "2026-02-13T11:26:45.109300"}
{"correlation_id": "8f61c8c0-f977-4008-82a2-cc9476bf341a", "start_time": 1770982002.1834068, "audio_duration_sec": 1.492, "asr_duration": 0.8198211193084717, "asr_confidence": 0.7933860755247159, "asr_text": "Von meinen Begierden.", "asr_word_count": 3, "llm_duration": 2.1267735958099365, "llm_text": "From my lusts.", "llm_word_count": 3, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.5430710315704346, "tts_audio_size_bytes": 71244, "e2e_duration": 4.9071948528289795, "rtf": 3.289, "timestamp": "2026-02-13T11:26:47.090612"}
{"correlation_id": "fab3d5aa-65df-44bf-b1b6-4ea25d98b72c", "start_time": 1770982005.8558457, "audio_duration_sec": 3.124, "asr_duration": 0.5235004425048828, "asr_confidence": 0.9268266151982738, "asr_text": "von meinen Zielen und Überzeugungen abzusehen.", "asr_word_count": 6, "llm_duration": 2.341653823852539, "llm_text": "to judge my purposes and convictions.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.1601362228393555, "tts_audio_size_bytes": 164428, "e2e_duration": 4.193815469741821, "rtf": 1.342, "timestamp": "2026-02-13T11:26:50.049670"}
{"correlation_id": "fa9c2b4b-7b0d-4333-85c2-7d689977bf52", "start_time": 1770982010.027524, "audio_duration_sec": 2.228, "asr_duration": 0.47617053985595703, "asr_confidence": 0.8128499080685612, "asr_text": "meinen fleischlichen Begierden", "asr_word_count": 3, "llm_duration": 1.624077558517456, "llm_text": "my fleshly desires", "llm_word_count": 3, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.7054545879364014, "tts_audio_size_bytes": 111180, "e2e_duration": 2.8062844276428223, "rtf": 1.26, "timestamp": "2026-02-13T11:26:52.833818"}
{"correlation_id": "943cd728-8a05-4e8e-9840-250d5335eda1", "start_time": 1770982020.008504, "audio_duration_sec": 0.532, "asr_duration": 0.4075789451599121, "asr_confidence": 0.4010880705223484, "asr_text": "...", "asr_word_count": 1, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "f63fc224-e4b7-46d0-9bcf-7d838e39aef0", "start_time": 1770982025.5085182, "audio_duration_sec": 0.436, "asr_duration": 0.8435652256011963, "asr_confidence": 0.6976581611185808, "asr_text": "Vielen Dank.", "asr_word_count": 2, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "477e316e-f83f-4aa3-a0da-f996f77f154f", "start_time": 1770982017.3939078, "audio_duration_sec": 6.836, "asr_duration": 0.9605216979980469, "asr_confidence": 0.9368681955634738, "asr_text": "Nicht untertan sein, sondern hören, was Jesus zu sagen hat und was seine Idee für mein und unser Leben ist.", "asr_word_count": 20, "llm_duration": 5.794553518295288, "llm_text": "Not subject to, but listen to what Jesus has to say, and what His idea is for my life and our life.", "llm_word_count": 22, "src_lang": "de", "tgt_lang": "en", "tts_duration": 5.589197397232056, "tts_audio_size_bytes": 371788, "e2e_duration": 12.344928741455078, "rtf": 1.806, "timestamp": "2026-02-13T11:27:09.738854"}
{"correlation_id": "7845328f-6d85-419f-b1f1-817dced67d52", "start_time": 1770982024.1954958, "audio_duration_sec": 3.828, "asr_duration": 1.4624314308166504, "asr_confidence": 0.9569543722235809, "asr_text": "Und wenn Jesus uns vorlebt zu fasten, dann sollten wir fasten.", "asr_word_count": 11, "llm_duration": 4.426665782928467, "llm_text": "And if Jesus himself fasts, then we should fast.", "llm_word_count": 9, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.5256984233856201, "tts_audio_size_bytes": 200268, "e2e_duration": 7.415745973587036, "rtf": 1.937, "timestamp": "2026-02-13T11:27:11.611256"}
{"correlation_id": "9abfead6-700b-451f-bccc-4a4146f84e91", "start_time": 1770982028.1315224, "audio_duration_sec": 2.292, "asr_duration": 1.0181853771209717, "asr_confidence": 0.9112092647212662, "asr_text": "Und wenn Jesus uns vorlebt zu beten.", "asr_word_count": 7, "llm_duration": 2.727902412414551, "llm_text": "And if Jesus teaches us to pray.", "llm_word_count": 7, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.1856627464294434, "tts_audio_size_bytes": 111180, "e2e_duration": 5.867960214614868, "rtf": 2.56, "timestamp": "2026-02-13T11:27:13.999493"}
{"correlation_id": "9984d174-7148-48d6-b78f-2a9cbd3b848e", "start_time": 1770982029.6920197, "audio_duration_sec": 1.46, "asr_duration": 0.45821523666381836, "asr_confidence": 0.8809661190961009, "asr_text": "Dann sollten wir beten.", "asr_word_count": 4, "llm_duration": 2.2039942741394043, "llm_text": "Then let us pray.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.3714072704315186, "tts_audio_size_bytes": 102476, "e2e_duration": 6.697538137435913, "rtf": 4.587, "timestamp": "2026-02-13T11:27:16.389577"}
{"correlation_id": "9e29ae6f-8473-4ac8-a0af-93b37b4a1b2a", "start_time": 1770982033.6343427, "audio_duration_sec": 2.1, "asr_duration": 0.5794451236724854, "asr_confidence": 0.8380456606731259, "asr_text": "Wenn Jesus uns vorlebt zu ruhen.", "asr_word_count": 6, "llm_duration": 3.2197043895721436, "llm_text": "If Jesus lives before us as one who rests.", "llm_word_count": 9, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.651827335357666, "tts_audio_size_bytes": 191564, "e2e_duration": 6.255676507949829, "rtf": 2.979, "timestamp": "2026-02-13T11:27:19.890033"}
{"correlation_id": "68ccc44d-b1dd-4309-9941-a68c7aaf406e", "start_time": 1770982035.4724946, "audio_duration_sec": 1.524, "asr_duration": 0.7152392864227295, "asr_confidence": 0.8731624302874399, "asr_text": "Dann sollten wir ruhen.", "asr_word_count": 4, "llm_duration": 2.172861337661743, "llm_text": "Then let us rest.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.192263126373291, "tts_audio_size_bytes": 73292, "e2e_duration": 6.131160736083984, "rtf": 4.023, "timestamp": "2026-02-13T11:27:21.603672"}
{"correlation_id": "8a5f0569-3a98-479b-924f-eefd0d1c63f9", "start_time": 1770982040.4379885, "audio_duration_sec": 2.74, "asr_duration": 0.9767739772796631, "asr_confidence": 0.9405075198112686, "asr_text": "Wenn Jesus uns Gemeinschaft vorlebt,", "asr_word_count": 5, "llm_duration": 2.1874237060546875, "llm_text": "When Jesus teaches us community.", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.4978137016296387, "tts_audio_size_bytes": 149068, "e2e_duration": 4.662660837173462, "rtf": 1.702, "timestamp": "2026-02-13T11:27:25.100658"}
{"correlation_id": "5f1e74e5-475a-4799-ac85-225dfbb610be", "start_time": 1770982043.3322046, "audio_duration_sec": 2.26, "asr_duration": 0.8247406482696533, "asr_confidence": 0.9455371470781996, "asr_text": "dann sollten wir auch in Gemeinschaft leben.", "asr_word_count": 7, "llm_duration": 2.72326922416687, "llm_text": "and we should also live in community.", "llm_word_count": 7, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.9285929203033447, "tts_audio_size_bytes": 122444, "e2e_duration": 4.477283239364624, "rtf": 1.981, "timestamp": "2026-02-13T11:27:27.809503"}
{"correlation_id": "2de7c9d2-59e1-479e-92fd-4453270e3936", "start_time": 1770982046.209543, "audio_duration_sec": 1.396, "asr_duration": 0.4386920928955078, "asr_confidence": 0.9115779891143797, "asr_text": "Und darum bemüht sein.", "asr_word_count": 4, "llm_duration": 1.918952465057373, "llm_text": "And therefore strive.", "llm_word_count": 3, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.7724747657775879, "tts_audio_size_bytes": 119884, "e2e_duration": 3.363114595413208, "rtf": 2.409, "timestamp": "2026-02-13T11:27:29.572667"}
{"correlation_id": "bb0ccbf8-8dab-4d37-8716-b241e16f7571", "start_time": 1770982051.974736, "audio_duration_sec": 3.636, "asr_duration": 0.8014962673187256, "asr_confidence": 0.9147883975128741, "asr_text": "wenn Jesus uns Hilfsbereitschaft und Großzügigkeit vorlebt.", "asr_word_count": 7, "llm_duration": 2.4868016242980957, "llm_text": "when Jesus shows us kindness and generosity.", "llm_word_count": 7, "src_lang": "de", "tgt_lang": "en", "tts_duration": 2.770841598510742, "tts_audio_size_bytes": 242764, "e2e_duration": 6.059897422790527, "rtf": 1.667, "timestamp": "2026-02-13T11:27:38.034646"}
{"correlation_id": "3d15643f-b1a5-4fd8-8abf-5b3df9d04ae9", "start_time": 1770982056.6672904, "audio_duration_sec": 3.444, "asr_duration": 1.202059030532837, "asr_confidence": 0.926858041039137, "asr_text": "dann sollten auch wir hilfsbereit und großzügig sein.", "asr_word_count": 8, "llm_duration": 3.0279626846313477, "llm_text": "and we too should be ready to help and generous.", "llm_word_count": 10, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.9959447383880615, "tts_audio_size_bytes": 155724, "e2e_duration": 6.226766347885132, "rtf": 1.808, "timestamp": "2026-02-13T11:27:42.894068"}
{"correlation_id": "d580cb06-90fc-4cb3-ab16-ed9e25102af6", "start_time": 1770982061.3865232, "audio_duration_sec": 2.804, "asr_duration": 0.8948242664337158, "asr_confidence": 0.9526064055746304, "asr_text": "Und wenn Jesus uns Vergebung und Liebe vorlebt?", "asr_word_count": 8, "llm_duration": 2.7222349643707275, "llm_text": "And if Jesus shows us forgiveness and love?", "llm_word_count": 8, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.3542747497558594, "tts_audio_size_bytes": 171596, "e2e_duration": 4.972156286239624, "rtf": 1.773, "timestamp": "2026-02-13T11:27:46.358688"}
{"correlation_id": "f2c5c28b-b98d-4909-9e18-1f9722725c73", "start_time": 1770982069.233299, "audio_duration_sec": 0.884, "asr_duration": 0.4166145324707031, "asr_confidence": 0.6552672878245662, "asr_text": "und lieben.", "asr_word_count": 2, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "7ef7b4ca-4f8b-44f3-b718-7081628c14e8", "start_time": 1770982068.1843438, "audio_duration_sec": 5.172, "asr_duration": 0.7125146389007568, "asr_confidence": 0.8496841213311757, "asr_text": "Dann sollten auch wir vergeben.", "asr_word_count": 5, "llm_duration": 2.1595537662506104, "llm_text": "And we also should forgive.", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.5714988708496094, "tts_audio_size_bytes": 86604, "e2e_duration": 3.444183826446533, "rtf": 0.666, "timestamp": "2026-02-13T11:27:51.628538"}
{"correlation_id": "e0ea8c1c-1884-4275-8864-8bc352563a99", "start_time": 1770982074.4875658, "audio_duration_sec": 1.62, "asr_duration": 0.7589461803436279, "asr_confidence": 0.9029836931726725, "asr_text": "auch wenn das nicht leicht ist.", "asr_word_count": 6, "llm_duration": 2.175431489944458, "llm_text": "even if this is not easy.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.7616755962371826, "tts_audio_size_bytes": 88652, "e2e_duration": 3.696692705154419, "rtf": 2.282, "timestamp": "2026-02-13T11:27:58.184267"}
{"correlation_id": "7962a9fe-89ad-4470-a053-1f11be187481", "start_time": 1770982081.036319, "audio_duration_sec": 5.78, "asr_duration": 0.9849889278411865, "asr_confidence": 0.9077707657726971, "asr_text": "Auch wenn mir das gar nicht in den Kram passt und ich manchmal sehr viel Wichtigeres zu tun habe.  Oder ich meine es zumindest.", "asr_word_count": 24, "llm_duration": 7.011139154434204, "llm_text": "Even if it does not fit into my plans at all, and I often have much more important things to do. Or at least I think so.", "llm_word_count": 27, "src_lang": "de", "tgt_lang": "en", "tts_duration": 2.6502811908721924, "tts_audio_size_bytes": 335980, "e2e_duration": 10.647097826004028, "rtf": 1.842, "timestamp": "2026-02-13T11:28:11.683428"}
{"correlation_id": "e397b959-34a7-484f-b932-012469d68050", "start_time": 1770982084.965109, "audio_duration_sec": 1.556, "asr_duration": 0.6772024631500244, "asr_confidence": 0.9054119608988437, "asr_text": "Aber das bedeutet es.", "asr_word_count": 4, "llm_duration": 2.3073108196258545, "llm_text": "But that means it.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.4387483596801758, "tts_audio_size_bytes": 62028, "e2e_duration": 7.1643993854522705, "rtf": 4.604, "timestamp": "2026-02-13T11:28:12.129522"}
{"correlation_id": "3449ae18-8e28-41b4-8c0f-627a243673e9", "start_time": 1770982087.5983593, "audio_duration_sec": 2.452, "asr_duration": 0.719296932220459, "asr_confidence": 0.9276270084849799, "asr_text": "nicht meinem menschlichen Willen nachzugehen.", "asr_word_count": 5, "llm_duration": 2.3176958560943604, "llm_text": "not to do my will.", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.413567304611206, "tts_audio_size_bytes": 119884, "e2e_duration": 7.474059820175171, "rtf": 3.048, "timestamp": "2026-02-13T11:28:15.072439"}
{"correlation_id": "a6d5ca13-4716-4ce6-8a43-f7ce82b227c9", "start_time": 1770982093.3796923, "audio_duration_sec": 3.156, "asr_duration": 1.1767852306365967, "asr_confidence": 0.9485856402409018, "asr_text": "Und ich stelle nochmal die Frage, die wir vorhin auch schon gehört hatten.", "asr_word_count": 13, "llm_duration": 3.6719586849212646, "llm_text": "And I ask the question again, which we heard just now.", "llm_word_count": 11, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.5149235725402832, "tts_audio_size_bytes": 182348, "e2e_duration": 6.364454746246338, "rtf": 2.017, "timestamp": "2026-02-13T11:28:19.744166"}
{"correlation_id": "a32f93b0-829a-425d-b15c-3e4b18489dd2", "start_time": 1770982096.528356, "audio_duration_sec": 2.484, "asr_duration": 0.474564790725708, "asr_confidence": 0.9477060131812515, "asr_text": "Wie würde unser Leben dann aussehen?", "asr_word_count": 6, "llm_duration": 2.8506240844726562, "llm_text": "What would our life then be like?", "llm_word_count": 7, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.7018182277679443, "tts_audio_size_bytes": 95820, "e2e_duration": 5.253645420074463, "rtf": 2.115, "timestamp": "2026-02-13T11:28:21.782015"}
{"correlation_id": "cace6c81-64d6-443c-8b5f-acce6dce0b2c", "start_time": 1770982099.9415016, "audio_duration_sec": 1.684, "asr_duration": 0.43806004524230957, "asr_confidence": 0.8977959193910922, "asr_text": "wenn wir das noch mehr machen.", "asr_word_count": 6, "llm_duration": 2.4480702877044678, "llm_text": "if we do this even more.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.9534375667572021, "tts_audio_size_bytes": 81996, "e2e_duration": 4.540541410446167, "rtf": 2.696, "timestamp": "2026-02-13T11:28:24.482053"}
{"correlation_id": "7ba53bfd-0229-4af2-b703-b131d47a6fc8", "start_time": 1770982103.3456755, "audio_duration_sec": 2.388, "asr_duration": 0.7739319801330566, "asr_confidence": 0.9573568211892127, "asr_text": "Wie würde unsere Gemeinde dann aussehen?", "asr_word_count": 6, "llm_duration": 2.50927734375, "llm_text": "What would our community then look like?", "llm_word_count": 7, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.5075492858886719, "tts_audio_size_bytes": 104524, "e2e_duration": 4.791525363922119, "rtf": 2.007, "timestamp": "2026-02-13T11:28:28.137211"}
{"correlation_id": "12ce3d81-e465-4fd2-812b-f9fb18e10e9c", "start_time": 1770982106.7455828, "audio_duration_sec": 2.26, "asr_duration": 0.8308024406433105, "asr_confidence": 0.9537408597693435, "asr_text": "Wie würden unsere Ehen aussehen?", "asr_word_count": 5, "llm_duration": 2.389810562133789, "llm_text": "What would our marriages look like?", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.6904566287994385, "tts_audio_size_bytes": 81996, "e2e_duration": 3.9118294715881348, "rtf": 1.731, "timestamp": "2026-02-13T11:28:30.657420"}
{"correlation_id": "3049a0ab-bb5b-445b-931a-83a5a440fde1", "start_time": 1770982111.177703, "audio_duration_sec": 2.228, "asr_duration": 0.4769718647003174, "asr_confidence": 0.9378471536929666, "asr_text": "Wie würden unsere Freundschaften aussehen?", "asr_word_count": 5, "llm_duration": 2.2002346515655518, "llm_text": "What would our friendships look like?", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.7216694355010986, "tts_audio_size_bytes": 91212, "e2e_duration": 3.399616003036499, "rtf": 1.526, "timestamp": "2026-02-13T11:28:34.577329"}
{"correlation_id": "bc3f11b0-c4f0-4af2-90c2-66229a5b9f36", "start_time": 1770982119.0127575, "audio_duration_sec": 4.052, "asr_duration": 0.8037204742431641, "asr_confidence": 0.9424453512284444, "asr_text": "Ich denke, einige von euch haben vielleicht gerade die ganz praktische Frage im Kopf.", "asr_word_count": 14, "llm_duration": 3.851733684539795, "llm_text": "I think some of you may have just the practical question on your hearts.", "llm_word_count": 14, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.720818042755127, "tts_audio_size_bytes": 171596, "e2e_duration": 6.376911878585815, "rtf": 1.574, "timestamp": "2026-02-13T11:28:45.389685"}
{"correlation_id": "efb436b4-9e8d-4d9c-8af4-452a51c38dd9", "start_time": 1770982123.442655, "audio_duration_sec": 3.764, "asr_duration": 0.8375310897827148, "asr_confidence": 0.8965288934180918, "asr_text": "Wann soll ich das denn eigentlich alles machen?", "asr_word_count": 8, "llm_duration": 3.0967214107513428, "llm_text": "When am I supposed to do all of this?", "llm_word_count": 9, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.406604290008545, "tts_audio_size_bytes": 106572, "e2e_duration": 5.341820478439331, "rtf": 1.419, "timestamp": "2026-02-13T11:28:48.784485"}
{"correlation_id": "0311ba63-3704-49d9-aab1-e69d510d2a40", "start_time": 1770982128.1413584, "audio_duration_sec": 2.804, "asr_duration": 0.764930248260498, "asr_confidence": 0.9125874598722357, "asr_text": "Ich komme ja auch so schon meinen To-Dos nicht hinterher.", "asr_word_count": 10, "llm_duration": 3.119858741760254, "llm_text": "I likewise do not keep up with my to-dos.", "llm_word_count": 9, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.1585330963134766, "tts_audio_size_bytes": 144460, "e2e_duration": 5.043977975845337, "rtf": 1.799, "timestamp": "2026-02-13T11:28:53.185348"}
{"correlation_id": "ab6dc791-9641-43a4-bc8c-72fdc95440bc", "start_time": 1770982140.9933555, "audio_duration_sec": 0.436, "asr_duration": 0.39345455169677734, "asr_confidence": 0.5894025905444853, "asr_text": "Vielen Dank.", "asr_word_count": 2, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "3278d9a4-031e-430e-b033-1a00dd4d37ea", "start_time": 1770982136.0262148, "audio_duration_sec": 4.436, "asr_duration": 0.950589656829834, "asr_confidence": 0.9559818201120235, "asr_text": "Und das Letzte, was ich will, ist, dass ich uns noch stressigere Lebensentwürfe präsentiere.", "asr_word_count": 14, "llm_duration": 4.625091075897217, "llm_text": "And the last thing I want is to present us with even more stressful life plans.", "llm_word_count": 16, "src_lang": "de", "tgt_lang": "en", "tts_duration": 2.0016191005706787, "tts_audio_size_bytes": 262732, "e2e_duration": 7.5779173374176025, "rtf": 1.708, "timestamp": "2026-02-13T11:29:03.604143"}
{"correlation_id": "f26e35c9-6b1f-4cef-9c14-b2be148d1e30", "start_time": 1770982137.8462977, "audio_duration_sec": 1.428, "asr_duration": 0.4406261444091797, "asr_confidence": 0.850763505619974, "asr_text": "Und uns da rein treibt.", "asr_word_count": 5, "llm_duration": 2.373436212539673, "llm_text": "And drives us therein.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.2490603923797607, "tts_audio_size_bytes": 81996, "e2e_duration": 7.379046440124512, "rtf": 5.167, "timestamp": "2026-02-13T11:29:05.225357"}
{"correlation_id": "55a4e184-93e2-497f-82ac-b814c8d33ce3", "start_time": 1770982139.9435894, "audio_duration_sec": 1.588, "asr_duration": 0.46924829483032227, "asr_confidence": 0.9170407761810577, "asr_text": "Das ist nicht mein Anliegen.", "asr_word_count": 5, "llm_duration": 2.5362966060638428, "llm_text": "This is not my concern.", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.6310639381408691, "tts_audio_size_bytes": 81996, "e2e_duration": 7.200407981872559, "rtf": 4.534, "timestamp": "2026-02-13T11:29:07.144012"}
{"correlation_id": "f0d8ba7b-1bf2-472c-9b09-600f7e9f3a6e", "start_time": 1770982144.4020474, "audio_duration_sec": 2.292, "asr_duration": 0.8305139541625977, "asr_confidence": 0.8319783493402835, "asr_text": "Aber ich will uns ermutigen.", "asr_word_count": 5, "llm_duration": 2.5760934352874756, "llm_text": "But I want to encourage us.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.0368645191192627, "tts_audio_size_bytes": 86604, "e2e_duration": 5.724180221557617, "rtf": 2.497, "timestamp": "2026-02-13T11:29:10.126238"}
{"correlation_id": "8dd0ab39-8462-41bb-ba62-55fb850e6043", "start_time": 1770982149.6485486, "audio_duration_sec": 1.268, "asr_duration": 0.5496034622192383, "asr_confidence": 0.6447484280787643, "asr_text": "Verschwinden?", "asr_word_count": 1, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "cb617da0-b54a-41b5-b3b1-bdb3dffd723e", "start_time": 1770982145.977268, "audio_duration_sec": 1.524, "asr_duration": 0.4589080810546875, "asr_confidence": 0.721681135675167, "asr_text": "Die Zeit, die wir mit...", "asr_word_count": 5, "llm_duration": 2.3023786544799805, "llm_text": "The time we spend with...", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.6240735054016113, "tts_audio_size_bytes": 81996, "e2e_duration": 6.0388875007629395, "rtf": 3.963, "timestamp": "2026-02-13T11:29:12.016176"}
{"correlation_id": "287a8076-d0d2-4a9a-afed-01643b3a9d22", "start_time": 1770982148.3379898, "audio_duration_sec": 2.036, "asr_duration": 0.4295961856842041, "asr_confidence": 0.778800774367628, "asr_text": "unwesentlichen Dingen", "asr_word_count": 2, "llm_duration": 1.579864501953125, "llm_text": "unworthy things", "llm_word_count": 2, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.5500214099884033, "tts_audio_size_bytes": 81996, "e2e_duration": 5.184311628341675, "rtf": 2.546, "timestamp": "2026-02-13T11:29:13.522311"}
{"correlation_id": "df6ee4c1-19fc-4c68-85b4-e0d6d80c15eb", "start_time": 1770982154.1112444, "audio_duration_sec": 3.476, "asr_duration": 0.5283355712890625, "asr_confidence": 0.8952860738561116, "asr_text": "Anfangen bewusst für geistliches Training zu nutzen.", "asr_word_count": 7, "llm_duration": 2.6043007373809814, "llm_text": "Begin to use it consciously for spiritual training.", "llm_word_count": 8, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.4275329113006592, "tts_audio_size_bytes": 186956, "e2e_duration": 4.560879230499268, "rtf": 1.312, "timestamp": "2026-02-13T11:29:18.672132"}
{"correlation_id": "4da2db11-2979-49ca-bc30-1d9422c4acc2", "start_time": 1770982160.1065154, "audio_duration_sec": 2.26, "asr_duration": 0.48634839057922363, "asr_confidence": 0.9003421066623158, "asr_text": "Bei einem mag das praktisch bedeuten,", "asr_word_count": 6, "llm_duration": 2.3766627311706543, "llm_text": "In one place this might practically mean,", "llm_word_count": 7, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.0574800968170166, "tts_audio_size_bytes": 124492, "e2e_duration": 3.9212396144866943, "rtf": 1.735, "timestamp": "2026-02-13T11:29:24.027763"}
{"correlation_id": "dddfbfdb-6646-4a63-bda3-bc655f8aa0d0", "start_time": 1770982164.547592, "audio_duration_sec": 4.02, "asr_duration": 0.5482864379882812, "asr_confidence": 0.9544914380908908, "asr_text": "dass die Bildschirmzeit um 30 Minuten am Tag reduziert wird.", "asr_word_count": 10, "llm_duration": 3.03706955909729, "llm_text": "that screen time is reduced by thirty minutes each day.", "llm_word_count": 10, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.639739990234375, "tts_audio_size_bytes": 213580, "e2e_duration": 5.225707292556763, "rtf": 1.3, "timestamp": "2026-02-13T11:29:29.773309"}
{"correlation_id": "cbb9b06a-bd1f-430c-86bc-1bb042c682db", "start_time": 1770982175.0258718, "audio_duration_sec": 1.172, "asr_duration": 0.5892167091369629, "asr_confidence": 0.6924865123528237, "asr_text": "oder laufen gehe.", "asr_word_count": 3, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "32bb5168-cadb-4635-a89f-5e463c395c19", "start_time": 1770982170.5767152, "audio_duration_sec": 3.892, "asr_duration": 0.5984516143798828, "asr_confidence": 0.9282095472702551, "asr_text": "Beim anderen mag es bedeuten, dass ich anstatt siebenmal in der Woche", "asr_word_count": 12, "llm_duration": 3.9760258197784424, "llm_text": "For another it may mean that I am to forgive seven times in a day", "llm_word_count": 15, "src_lang": "de", "tgt_lang": "en", "tts_duration": 2.5537307262420654, "tts_audio_size_bytes": 282700, "e2e_duration": 7.128886699676514, "rtf": 1.832, "timestamp": "2026-02-13T11:29:37.705621"}
{"correlation_id": "4bc184f2-1177-47f9-803f-9058553844d7", "start_time": 1770982173.451855, "audio_duration_sec": 2.58, "asr_duration": 0.6627800464630127, "asr_confidence": 0.8577990429292492, "asr_text": "Nur noch fünf oder sechs Mal ins Fitnessstudio gehen.", "asr_word_count": 9, "llm_duration": 3.6738436222076416, "llm_text": "Only go to the gym five or six more times.", "llm_word_count": 10, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.4778342247009277, "tts_audio_size_bytes": 178252, "e2e_duration": 6.852032899856567, "rtf": 2.656, "timestamp": "2026-02-13T11:29:40.303903"}
{"correlation_id": "e3ade157-17ad-417d-b054-d704302ce046", "start_time": 1770982180.782182, "audio_duration_sec": 3.284, "asr_duration": 0.4807314872741699, "asr_confidence": 0.8871052354631817, "asr_text": "Wieder bei einem anderen kann das bedeuten.", "asr_word_count": 7, "llm_duration": 2.181062936782837, "llm_text": "That can mean being with another.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.93975830078125, "tts_audio_size_bytes": 106572, "e2e_duration": 3.6021957397460938, "rtf": 1.097, "timestamp": "2026-02-13T11:29:44.384406"}
{"correlation_id": "98ddfaa3-1bc2-450f-9e0e-13c608df6694", "start_time": 1770982184.7019227, "audio_duration_sec": 3.188, "asr_duration": 0.48865532875061035, "asr_confidence": 0.8463439655366928, "asr_text": "Nach bereits zehn Stunden getaner Arbeit am Tag", "asr_word_count": 8, "llm_duration": 2.559351682662964, "llm_text": "After already ten hours of work in a day", "llm_word_count": 9, "src_lang": "de", "tgt_lang": "en", "tts_duration": 2.1686108112335205, "tts_audio_size_bytes": 189004, "e2e_duration": 5.217250108718872, "rtf": 1.637, "timestamp": "2026-02-13T11:29:49.919186"}
{"correlation_id": "e2b64c93-c003-4b14-be9a-ff31c6f899b4", "start_time": 1770982187.8306093, "audio_duration_sec": 2.74, "asr_duration": 0.8652536869049072, "asr_confidence": 0.900907513489061, "asr_text": "abends auch mal die Arbeit ruhen zu lassen.", "asr_word_count": 8, "llm_duration": 3.0147972106933594, "llm_text": "to rest even on the sabbath day.", "llm_word_count": 7, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.8598155975341797, "tts_audio_size_bytes": 113228, "e2e_duration": 4.740580081939697, "rtf": 1.73, "timestamp": "2026-02-13T11:29:52.571198"}
{"correlation_id": "36b8d0af-6be9-431f-a9c0-92e21d69060a", "start_time": 1770982196.7461355, "audio_duration_sec": 1.044, "asr_duration": 0.38748764991760254, "asr_confidence": 0.5939286534628994, "asr_text": "sondern", "asr_word_count": 1, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "989abd0f-d94b-4f2a-80da-93e1d0c52fac", "start_time": 1770982194.9133036, "audio_duration_sec": 4.148, "asr_duration": 0.809654712677002, "asr_confidence": 0.8847677533751881, "asr_text": "Und diese gewonnene Zeit dann aber nicht mit etwas anderem vergeuden,", "asr_word_count": 11, "llm_duration": 3.2892324924468994, "llm_text": "And let this gained time not be filled with anything else", "llm_word_count": 11, "src_lang": "de", "tgt_lang": "en", "tts_duration": 2.0272250175476074, "tts_audio_size_bytes": 200268, "e2e_duration": 6.126779556274414, "rtf": 1.477, "timestamp": "2026-02-13T11:30:01.040098"}
{"correlation_id": "3bb09b70-5c60-4eea-a7fa-48d46f1177a9", "start_time": 1770982198.8484385, "audio_duration_sec": 1.78, "asr_duration": 0.7074184417724609, "asr_confidence": 0.9137616212038895, "asr_text": "in unser Training zu investieren.", "asr_word_count": 5, "llm_duration": 2.3477230072021484, "llm_text": "to invest in our training.", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.8086967468261719, "tts_audio_size_bytes": 91212, "e2e_duration": 3.8645541667938232, "rtf": 2.171, "timestamp": "2026-02-13T11:30:02.713004"}
{"correlation_id": "a664e1fc-4b86-49d8-8ec6-12de35bda765", "start_time": 1770982209.3431425, "audio_duration_sec": 7.86, "asr_duration": 0.9950411319732666, "asr_confidence": 0.9410124644408686, "asr_text": "Ich will an dieser Stelle nochmal klar herausstellen, dass dieses Training nicht dafür Sorge trägt, dass wir gerecht vor Gott stehen.", "asr_word_count": 21, "llm_duration": 5.16778564453125, "llm_text": "I want to make this clear at this point that this training does not ensure that we stand righteous before God.", "llm_word_count": 21, "src_lang": "de", "tgt_lang": "en", "tts_duration": 2.853612184524536, "tts_audio_size_bytes": 354380, "e2e_duration": 9.017138481140137, "rtf": 1.147, "timestamp": "2026-02-13T11:30:18.360294"}
{"correlation_id": "29a49961-1d30-481d-b648-db96c8f3ea13", "start_time": 1770982218.5231643, "audio_duration_sec": 7.092, "asr_duration": 0.7467970848083496, "asr_confidence": 0.9643866076705209, "asr_text": "Es ersetzt nicht die Gnade und daraus die Rettung unseres Herrn und stellt diese schon gar nicht in Frage.", "asr_word_count": 19, "llm_duration": 4.619177341461182, "llm_text": "It does not take away grace nor the salvation of our Lord, nor does it question these.", "llm_word_count": 17, "src_lang": "de", "tgt_lang": "en", "tts_duration": 3.347553253173828, "tts_audio_size_bytes": 323148, "e2e_duration": 8.71422266960144, "rtf": 1.229, "timestamp": "2026-02-13T11:30:27.237404"}
{"correlation_id": "4cb7c9c1-f4d3-4ba4-85e3-dd4597690ec6", "start_time": 1770982224.5610747, "audio_duration_sec": 5.076, "asr_duration": 0.8203461170196533, "asr_confidence": 0.9419648410085728, "asr_text": "Dieses Training gehört zu unserer neuen Identität als Nachfolger Jesu.", "asr_word_count": 10, "llm_duration": 3.6673803329467773, "llm_text": "This training belongs to our new identity as successors of Jesus.", "llm_word_count": 11, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.9974322319030762, "tts_audio_size_bytes": 258124, "e2e_duration": 6.485865116119385, "rtf": 1.278, "timestamp": "2026-02-13T11:30:31.046949"}
{"correlation_id": "2298c16f-f5b0-416a-9d47-3513ea7aa609", "start_time": 1770982234.2968652, "audio_duration_sec": 5.684, "asr_duration": 1.018078088760376, "asr_confidence": 0.9596058628664577, "asr_text": "Und dabei will ich uns auch keinen Profi-Trainingsplan aufbinden, der übrigens morgen startet.", "asr_word_count": 13, "llm_duration": 5.838963270187378, "llm_text": "And yet, I do not want to impose on you a professional training plan that, by the way, starts tomorrow.", "llm_word_count": 20, "src_lang": "de", "tgt_lang": "en", "tts_duration": 3.7908213138580322, "tts_audio_size_bytes": 394316, "e2e_duration": 10.648832559585571, "rtf": 1.873, "timestamp": "2026-02-13T11:30:44.945713"}
{"correlation_id": "ebd8b782-f371-46a1-85ca-6d7f8ddabed5", "start_time": 1770982237.1718352, "audio_duration_sec": 1.78, "asr_duration": 0.6541178226470947, "asr_confidence": 0.9151904924773482, "asr_text": "Fünf Stunden am Tag zu beten.", "asr_word_count": 6, "llm_duration": 2.971414804458618, "llm_text": "Five hours a day to pray.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.7479023933410645, "tts_audio_size_bytes": 97868, "e2e_duration": 8.5308096408844, "rtf": 4.793, "timestamp": "2026-02-13T11:30:45.702658"}
{"correlation_id": "2da44ad5-90fb-44fa-ab7e-14bcc56a3bb4", "start_time": 1770982240.0470397, "audio_duration_sec": 2.164, "asr_duration": 0.6384055614471436, "asr_confidence": 0.8738597560390532, "asr_text": "Und drei Stunden am Tag Bibel zu lesen.", "asr_word_count": 8, "llm_duration": 3.174675226211548, "llm_text": "And to read the Bible three hours a day.", "llm_word_count": 9, "src_lang": "de", "tgt_lang": "en", "tts_duration": 2.254019260406494, "tts_audio_size_bytes": 166988, "e2e_duration": 9.508686304092407, "rtf": 4.394, "timestamp": "2026-02-13T11:30:49.555747"}
{"correlation_id": "fd1399ca-a066-4b7d-86fe-00b33a028456", "start_time": 1770982243.2027898, "audio_duration_sec": 2.548, "asr_duration": 0.9171380996704102, "asr_confidence": 0.8815637694901807, "asr_text": "Und jeden Tag 20 Euro zu spenden.", "asr_word_count": 7, "llm_duration": 3.077587842941284, "llm_text": "And to give twenty euros each day.", "llm_word_count": 7, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.6374468803405762, "tts_audio_size_bytes": 119884, "e2e_duration": 8.814350843429565, "rtf": 3.459, "timestamp": "2026-02-13T11:30:52.017154"}
{"correlation_id": "365fc2f5-f29f-415f-9d93-5382f7ec898b", "start_time": 1770982247.6609268, "audio_duration_sec": 3.636, "asr_duration": 1.1795096397399902, "asr_confidence": 0.9471592888359707, "asr_text": "und sich täglich mit mindestens fünf Geschwistern aus der Gemeinde zu treffen.", "asr_word_count": 12, "llm_duration": 3.784477472305298, "llm_text": "and to meet daily with at least five brothers from the congregation.", "llm_word_count": 12, "src_lang": "de", "tgt_lang": "en", "tts_duration": 3.262641191482544, "tts_audio_size_bytes": 313932, "e2e_duration": 9.766225814819336, "rtf": 2.686, "timestamp": "2026-02-13T11:30:57.427167"}
{"correlation_id": "aa86e815-0280-402c-bcd7-3cffbb6cbbc6", "start_time": 1770982251.0472198, "audio_duration_sec": 1.94, "asr_duration": 0.9036824703216553, "asr_confidence": 0.9365886825564491, "asr_text": "könnten diese Liste lange fortführen.", "asr_word_count": 5, "llm_duration": 3.5334768295288086, "llm_text": "could this list go on for a long time.", "llm_word_count": 9, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.3338286876678467, "tts_audio_size_bytes": 102476, "e2e_duration": 7.984927415847778, "rtf": 4.116, "timestamp": "2026-02-13T11:30:59.032162"}
{"correlation_id": "692e60e4-20f1-4f1b-996f-ec9dcfc9802a", "start_time": 1770982254.9781773, "audio_duration_sec": 1.94, "asr_duration": 0.8039035797119141, "asr_confidence": 0.8925032289497147, "asr_text": "Aber ich möchte uns mal anhalten.", "asr_word_count": 6, "llm_duration": 3.1017773151397705, "llm_text": "But I want to detain us for a moment.", "llm_word_count": 9, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.4913089275360107, "tts_audio_size_bytes": 117836, "e2e_duration": 7.313563108444214, "rtf": 3.77, "timestamp": "2026-02-13T11:31:02.291755"}
{"correlation_id": "734c5574-2865-4408-8143-fcf56f6c8486", "start_time": 1770982263.0658937, "audio_duration_sec": 0.468, "asr_duration": 0.3926961421966553, "asr_confidence": 0.592287570557425, "asr_text": "Vielen Dank.", "asr_word_count": 2, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "5d3af536-c3b7-4cbd-a78a-c16989f7160b", "start_time": 1770982258.3701181, "audio_duration_sec": 3.092, "asr_duration": 0.7874648571014404, "asr_confidence": 0.9070871572660345, "asr_text": "Jetzt darüber nachzudenken, wo wir stehen.", "asr_word_count": 6, "llm_duration": 2.684453248977661, "llm_text": "Now to consider where we stand.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.16404128074646, "tts_audio_size_bytes": 151116, "e2e_duration": 6.279148101806641, "rtf": 2.031, "timestamp": "2026-02-13T11:31:04.649280"}
{"correlation_id": "a9579cae-7156-44dd-863a-e65058015d75", "start_time": 1770982261.2454493, "audio_duration_sec": 1.46, "asr_duration": 0.7769713401794434, "asr_confidence": 0.8822814771809321, "asr_text": "Jeder für sich selber.", "asr_word_count": 4, "llm_duration": 2.110098361968994, "llm_text": "Every man for himself.", "llm_word_count": 4, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.9436073303222656, "tts_audio_size_bytes": 91212, "e2e_duration": 5.293819904327393, "rtf": 3.626, "timestamp": "2026-02-13T11:31:06.539284"}
{"correlation_id": "1972d656-4b76-416e-8873-1c703cdccbdc", "start_time": 1770982267.5373461, "audio_duration_sec": 0.404, "asr_duration": 0.38960814476013184, "asr_confidence": 0.6859482201512823, "asr_text": "Vielen Dank.", "asr_word_count": 2, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "ba13db0f-46d4-4089-bdee-b36574cd0ba7", "start_time": 1770982265.4345264, "audio_duration_sec": 1.876, "asr_duration": 0.6454787254333496, "asr_confidence": 0.9245327561097944, "asr_text": "Wie sieht denn mein Training aus?", "asr_word_count": 6, "llm_duration": 2.2512130737304688, "llm_text": "What is my training like?", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.5003921985626221, "tts_audio_size_bytes": 81996, "e2e_duration": 3.3978207111358643, "rtf": 1.811, "timestamp": "2026-02-13T11:31:08.832357"}
{"correlation_id": "7e0dba13-ded7-4e2b-bafc-0ab362c09916", "start_time": 1770982269.614668, "audio_duration_sec": 1.972, "asr_duration": 0.4676518440246582, "asr_confidence": 0.887422938936509, "asr_text": "Wie sieht denn mein Leben aus?", "asr_word_count": 6, "llm_duration": 1.8957595825195312, "llm_text": "What is my life like?", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.2932896614074707, "tts_audio_size_bytes": 75340, "e2e_duration": 3.657421350479126, "rtf": 1.855, "timestamp": "2026-02-13T11:31:13.272099"}
{"correlation_id": "d8f952b0-d19a-4d11-b8cf-4de0ef34f56f", "start_time": 1770982273.2930338, "audio_duration_sec": 0.564, "asr_duration": 0.45360493659973145, "asr_confidence": 0.5876400673659092, "asr_text": "Untertitelung. BR 2018", "asr_word_count": 3, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "466cad67-79f8-43b6-85f6-e7d8142fcbff", "start_time": 1770982272.243216, "audio_duration_sec": 2.484, "asr_duration": 0.8279950618743896, "asr_confidence": 0.9615438715794595, "asr_text": "wenn ich nicht sonntags im Gottesdienst sitze.", "asr_word_count": 7, "llm_duration": 3.5075271129608154, "llm_text": "if I do not sit in the house of worship on Sundays.", "llm_word_count": 12, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.7370619773864746, "tts_audio_size_bytes": 133708, "e2e_duration": 6.073301792144775, "rtf": 2.445, "timestamp": "2026-02-13T11:31:18.316537"}
{"correlation_id": "25b2f31c-2bb0-4c10-8947-d7dc3d487c4d", "start_time": 1770982278.7957828, "audio_duration_sec": 0.468, "asr_duration": 0.395261287689209, "asr_confidence": 0.5467076140794211, "asr_text": "Vielen Dank.", "asr_word_count": 2, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "16b2bb69-5f3d-481f-8be6-8a372f186d86", "start_time": 1770982277.227797, "audio_duration_sec": 2.1, "asr_duration": 0.8769829273223877, "asr_confidence": 0.9043809903139121, "asr_text": "Wie steht es um meine Zeit mit Gott?", "asr_word_count": 8, "llm_duration": 2.3673908710479736, "llm_text": "How is my time with God?", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.49563121795654297, "tts_audio_size_bytes": 77900, "e2e_duration": 3.740786075592041, "rtf": 1.781, "timestamp": "2026-02-13T11:31:20.968593"}
{"correlation_id": "a47a936d-bfcf-4826-9751-f2944be88a26", "start_time": 1770982288.9917974, "audio_duration_sec": 0.5, "asr_duration": 0.5577235221862793, "asr_confidence": 0.48990604227037476, "asr_text": "... Musik ...", "asr_word_count": 3, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "c10c6c3e-c445-4fbd-895a-bd6303b87c2b", "start_time": 1770982286.1343017, "audio_duration_sec": 5.428, "asr_duration": 0.9927268028259277, "asr_confidence": 0.9679917272881525, "asr_text": "Habe ich es mir vielleicht bequem gemacht, weil ich jeden Tag kurz fünf Verse lese und dann mein Soll erfüllt ist?", "asr_word_count": 21, "llm_duration": 6.012251377105713, "llm_text": "Have I perhaps made myself at ease, because I read just five verses each day and then think I have fulfilled my duty?", "llm_word_count": 23, "src_lang": "de", "tgt_lang": "en", "tts_duration": 3.404911518096924, "tts_audio_size_bytes": 398924, "e2e_duration": 10.410588502883911, "rtf": 1.918, "timestamp": "2026-02-13T11:31:36.544907"}
{"correlation_id": "d98d3094-56cf-4403-86fa-172790a45eeb", "start_time": 1770982291.3476875, "audio_duration_sec": 1.812, "asr_duration": 0.5677609443664551, "asr_confidence": 0.9592480037697717, "asr_text": "Ich kann nicht in euch reinschauen.", "asr_word_count": 6, "llm_duration": 2.9808268547058105, "llm_text": "I cannot look into your hearts.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.4537959098815918, "tts_audio_size_bytes": 104524, "e2e_duration": 6.660820245742798, "rtf": 3.676, "timestamp": "2026-02-13T11:31:38.008518"}
{"correlation_id": "d3879930-6e0e-46bf-8b10-63e682a87eba", "start_time": 1770982292.9103737, "audio_duration_sec": 1.396, "asr_duration": 0.7023086547851562, "asr_confidence": 0.9373969576764383, "asr_text": "Und ihr auch nicht in mich.", "asr_word_count": 6, "llm_duration": 2.996664524078369, "llm_text": "And do not think to dwell in me.", "llm_word_count": 8, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.1775593757629395, "tts_audio_size_bytes": 95820, "e2e_duration": 7.3853442668914795, "rtf": 5.29, "timestamp": "2026-02-13T11:31:40.295728"}
{"correlation_id": "30be217c-8019-4df8-9318-af50de689c8e", "start_time": 1770982296.8378391, "audio_duration_sec": 2.26, "asr_duration": 0.7578616142272949, "asr_confidence": 0.9136277819298513, "asr_text": "aber vor uns selbst und vor Gott.", "asr_word_count": 7, "llm_duration": 2.5008530616760254, "llm_text": "but before us and before God.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.0131149291992188, "tts_audio_size_bytes": 135756, "e2e_duration": 5.794618129730225, "rtf": 2.564, "timestamp": "2026-02-13T11:31:42.632473"}
{"correlation_id": "c6579ec5-74bd-4c6a-a473-873bf40eb31b", "start_time": 1770982304.436687, "audio_duration_sec": 0.564, "asr_duration": 0.6939780712127686, "asr_confidence": 0.5625949818331907, "asr_text": "Vielen Dank.", "asr_word_count": 2, "rejected": true, "rejection_reason": "low_confidence"}
{"correlation_id": "15dc9107-b8ae-439f-857b-2e909d3145f2", "start_time": 1770982299.7267354, "audio_duration_sec": 2.644, "asr_duration": 0.7347555160522461, "asr_confidence": 0.9144646182892294, "asr_text": "Dürfen wir mal einen ehrlichen Blick zulassen?", "asr_word_count": 7, "llm_duration": 2.5794031620025635, "llm_text": "May we allow a candid look?", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 1.369394063949585, "tts_audio_size_bytes": 95820, "e2e_duration": 5.841738700866699, "rtf": 2.209, "timestamp": "2026-02-13T11:31:45.568493"}
{"correlation_id": "3060e3bd-7dfc-4a89-bd1c-3ae2c99997d1", "start_time": 1770982303.1189966, "audio_duration_sec": 1.748, "asr_duration": 0.4458930492401123, "asr_confidence": 0.9194905182225969, "asr_text": "Und genau das machen wir jetzt.", "asr_word_count": 6, "llm_duration": 3.1971230506896973, "llm_text": "And that is exactly what we are doing now.", "llm_word_count": 9, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.924553632736206, "tts_audio_size_bytes": 117836, "e2e_duration": 5.20209527015686, "rtf": 2.976, "timestamp": "2026-02-13T11:31:48.321107"}
{"correlation_id": "3a1e4bee-23c9-4c17-b949-9ad22ce94e21", "start_time": 1770982306.8062162, "audio_duration_sec": 2.324, "asr_duration": 0.4862382411956787, "asr_confidence": 0.9036283348623056, "asr_text": "Hier vorne könnt ihr kurze Fragen lesen.", "asr_word_count": 7, "llm_duration": 3.1071345806121826, "llm_text": "Here you can read short questions at the front.", "llm_word_count": 9, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.975130558013916, "tts_audio_size_bytes": 122444, "e2e_duration": 4.6729302406311035, "rtf": 2.011, "timestamp": "2026-02-13T11:31:51.479168"}
{"correlation_id": "15e7b115-2b5c-4c69-beac-d1397e3d61a9", "start_time": 1770982309.9471276, "audio_duration_sec": 1.78, "asr_duration": 0.549201250076294, "asr_confidence": 0.9412036899762292, "asr_text": "die ihr euch selber stellen könnt.", "asr_word_count": 6, "llm_duration": 2.2065625190734863, "llm_text": "that ye also may stand.", "llm_word_count": 5, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.689852237701416, "tts_audio_size_bytes": 104524, "e2e_duration": 3.4536397457122803, "rtf": 1.94, "timestamp": "2026-02-13T11:31:53.400780"}
{"correlation_id": "6e784c31-9509-4db2-82ac-22ebbf5fb326", "start_time": 1770982314.4103854, "audio_duration_sec": 2.26, "asr_duration": 0.48159289360046387, "asr_confidence": 0.9544934287094534, "asr_text": "Nimm dir dafür mal einen Augenblick Zeit.", "asr_word_count": 7, "llm_duration": 2.336514711380005, "llm_text": "Take thee hence a moment's time.", "llm_word_count": 6, "src_lang": "de", "tgt_lang": "en", "tts_duration": 0.8475456237792969, "tts_audio_size_bytes": 102476, "e2e_duration": 3.666443109512329, "rtf": 1.622, "timestamp": "2026-02-13T11:31:58.076840"}
{"correlation_id": "693d2427-2d14-4e8c-b9cb-da2b01351c17", "start_time": 1770982319.3973622, "audio_duration_sec": 0.468, "asr_duration": 0.40651440620422363, "asr_confidence": 0.4699127060516439, "asr_text": "... Musik ...", "asr_word_count": 3, "rejected": true, "rejection_reason": "low_confidence"}
